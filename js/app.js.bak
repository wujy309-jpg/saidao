/**
 * 导出数据
 */
function exportData(type, format) {
  let data;
  let filename;
  
  switch (type) {
    case 'tasks':
      data = dataManager.getTasks();
      filename = 'tasks';
      break;
    case 'records':
      data = dataManager.getRecords();
      filename = 'records';
      break;
    case 'evaluations':
      data = dataManager.getEvaluations();
      filename = 'evaluations';
      break;
    case 'users':
      data = dataManager.getUsers();
      filename = 'users';
      break;
    default:
      showToast('未知数据类型', 'error');
      return;
  }

  if (format === 'json') {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    downloadBlob(blob, `${filename}_${new Date().toISOString().split('T')[0]}.json`);
  } else if (format === 'csv') {
    const csv = convertToCSV(data);
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
    downloadBlob(blob, `${filename}_${new Date().toISOString().split('T')[0]}.csv`);
  }
  
  showToast(`${filename} 数据已导出`, 'success');
}

/**
 * 转换为CSV格式
 */
function convertToCSV(data) {
  if (data.length === 0) return '';
  
  const headers = Object.keys(data[0]);
  const rows = data.map(item => 
    headers.map(header => {
      let value = item[header];
      if (typeof value === 'object') value = JSON.stringify(value);
      if (typeof value === 'string' && (value.includes(',') || value.includes('"') || value.includes('\n'))) {
        value = '"' + value.replace(/"/g, '""') + '"';
      }
      return value;
    }).join(',')
  );
  
  return [headers.join(','), ...rows].join('\n');
}

/**
 * 下载Blob文件
 */
function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  a.click();
  URL.revokeObjectURL(url);
}

// ==================== 通知消息页面 ====================

function renderNotifications() {
  const currentUser = dataManager.getCurrentUser();
  const notifications = dataManager.getNotifications(currentUser.id);

  // 统计未读消息
  const unreadCount = notifications.filter(n => !n.read).length;

  return `
    <div class="page-header">
      <h1><i data-lucide="bell" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>通知消息</h1>
      <div class="subtitle">查看系统通知和消息</div>
    </div>

    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="mail"></i></div>
        <div class="info">
          <h3>${notifications.length}</h3>
          <p>消息总数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="bell-ring"></i></div>
        <div class="info">
          <h3>${unreadCount}</h3>
          <p>未读消息</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>消息列表</h3>
        <div class="flex gap-2">
          <button class="btn btn-outline btn-sm" onclick="markAllNotificationsRead()">全部已读</button>
          <button class="btn btn-danger btn-sm" onclick="clearAllNotifications()">清空消息</button>
        </div>
      </div>
      <div class="card-body">
        <div id="notifications-list">
          ${notifications.length > 0 ? notifications.map(notification => `
            <div class="notification-item ${notification.read ? '' : 'unread'} p-4 mb-3" 
                 style="background:var(--bg-tertiary); border-radius:var(--radius-lg); border-left:4px solid ${notification.read ? 'var(--border-color)' : 'var(--primary-500)'};">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <i data-lucide="${getNotificationIcon(notification.type)}" style="width:20px;height:20px"></i>
                  <span class="font-semibold">${notification.title}</span>
                  ${!notification.read ? '<span class="badge badge-primary">未读</span>' : ''}
                </div>
                <span class="text-muted text-sm">${notification.createdAt}</span>
              </div>
              <p class="text-muted">${notification.content}</p>
              <div class="mt-2 flex gap-2">
                ${!notification.read ? `
                  <button class="btn btn-sm btn-outline" onclick="markNotificationRead('${notification.id}')">标为已读</button>
                ` : ''}
                <button class="btn btn-sm btn-danger" onclick="deleteNotification('${notification.id}')">删除</button>
              </div>
            </div>
          `).join('') : `
            <div class="text-center text-muted" style="padding:40px;">
              <i data-lucide="inbox" style="width:48px;height:48px;margin-bottom:16px;opacity:0.5"></i>
              <h3>暂无消息</h3>
              <p>您暂时没有收到任何通知</p>
            </div>
          `}
        </div>
      </div>
    </div>
  `;
}

/**
 * 获取通知图标
 */
function getNotificationIcon(type) {
  const icons = {
    'task': 'clipboard-list',
    'evaluation': 'star',
    'record': 'file-text',
    'system': 'settings',
    'warning': 'alert-triangle',
    'success': 'check-circle'
  };
  return icons[type] || 'bell';
}

