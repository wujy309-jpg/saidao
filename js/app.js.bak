      <div class="subtitle">管理系统参数和配置</div>
    </div>

    <div class="grid grid-2 gap-6">
      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="info" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>基本信息</h3>
        </div>
