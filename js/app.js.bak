        <textarea class="form-control" name="description" placeholder="请输入材料描述"></textarea>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>材料类型 *</label>
          <select class="form-control" name="materialType" required>
            <option value="CODE">代码</option>
            <option value="REQUIREMENT_DOC">需求文档</option>
            <option value="DESIGN_DOC">设计文档</option>
            <option value="TEST_DOC">测试文档</option>
            <option value="PROJECT_REPORT">项目报告</option>
            <option value="OTHER">其他</option>
          </select>
        </div>
        
        <div class="form-group">
          <label>关联任务</label>
          <select class="form-control" name="taskId">
            <option value="">-- 无关联任务 --</option>
            ${tasks.map(task => `
              <option value="${task.id}">${task.title}</option>
            `).join('')}
          </select>
        </div>
      </div>
      
      <div class="form-group">
        <label>版本号</label>
        <input type="text" class="form-control" name="version" placeholder="例如：1.0" value="1.0">
      </div>
      
      <div class="form-group">
        <label>上传文件 *</label>
        <input type="file" class="form-control" name="file" required>
        <div class="text-muted text-sm mt-1">支持的文件格式：代码文件、PDF、Word、Excel等</div>
      </div>
      
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">提交材料</button>
      </div>
    </form>
  `;
  
  showModal('提交实训材料', content);
}

/**
 * 处理材料提交
 */
async function handleSubmitMaterial(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  
  const file = formData.get('file');
  const requestData = {
    title: formData.get('title'),
    description: formData.get('description'),
    materialType: formData.get('materialType'),
    taskId: formData.get('taskId') ? parseInt(formData.get('taskId')) : null,
    version: formData.get('version')
  };
  
  try {
    // 尝试调用后端API
    if (window.API && window.API.getCurrentUserId()) {
      const response = await window.API.MaterialAPI.submit(file, requestData);
      if (response.success) {
        closeModal();
        showToast('材料提交成功，AI评审将在后台进行', 'success');
        loadMaterials();
        return;
      }
    }
  } catch (error) {
    console.warn('调用后端API失败，使用本地模拟:', error);
  }
  
  // 本地模拟提交
  const currentUser = dataManager.getCurrentUser();
  const newMaterial = {
    id: Date.now(),
    title: requestData.title,
    description: requestData.description,
    type: requestData.materialType,
    typeName: getMaterialTypeName(requestData.materialType),
    fileName: file.name,
    fileSize: file.size,
    fileType: file.type,
    version: requestData.version,
    status: 'SUBMITTED',
    statusName: '已提交',
    submitterId: currentUser.id,
    submitterName: currentUser.name,
    taskId: requestData.taskId,
    taskTitle: requestData.taskId ? getTaskTitle(requestData.taskId) : null,
    aiScore: null,
    aiFeedback: null,
    createdAt: new Date().toLocaleString()
  };
  
  // 保存到本地存储
  saveLocalMaterial(newMaterial);
  
  closeModal();
  showToast('材料提交成功，AI评审将在后台进行', 'success');
  loadMaterials();
}

/**
 * 获取材料类型名称
 */
function getMaterialTypeName(type) {
  const typeMap = {
    'CODE': '代码',
    'REQUIREMENT_DOC': '需求文档',
    'DESIGN_DOC': '设计文档',
    'TEST_DOC': '测试文档',
    'PROJECT_REPORT': '项目报告',
    'OTHER': '其他'
  };
  return typeMap[type] || type;
}

/**
 * 获取任务标题
 */
function getTaskTitle(taskId) {
  const tasks = dataManager.getTasks();
  const task = tasks.find(t => t.id === taskId);
  return task ? task.title : null;
}

/**
 * 保存本地材料
 */
function saveLocalMaterial(material) {
  let materials = JSON.parse(localStorage.getItem('materials') || '[]');
  materials.push(material);
  localStorage.setItem('materials', JSON.stringify(materials));
}

/**
 * 显示材料详情
 */
function showMaterialDetail(materialId) {
  // 获取材料数据
  const materials = getLocalMaterials();
  const material = materials.find(m => m.id === materialId);
  
  if (!material) {
    showToast('材料不存在', 'error');
    return;
  }
  
  const content = `
    <div class="flex flex-col gap-4">
      <div>
        <strong>材料名称：</strong>${material.title}
      </div>
      <div>
        <strong>材料描述：</strong>${material.description || '无'}
      </div>
      <div class="grid grid-2 gap-4">
        <div><strong>材料类型：</strong>${material.typeName}</div>
        <div><strong>文件名：</strong>${material.fileName}</div>
        <div><strong>文件大小：</strong>${formatFileSize(material.fileSize)}</div>
        <div><strong>版本号：</strong>${material.version}</div>
        <div><strong>状态：</strong>${getMaterialStatusBadge(material.status)}</div>
        <div><strong>提交者：</strong>${material.submitterName}</div>
        <div><strong>关联任务：</strong>${material.taskTitle || '无'}</div>
        <div><strong>提交时间：</strong>${material.createdAt}</div>
      </div>
      
      ${material.aiScore !== null ? `
        <div class="card mt-4">
          <div class="card-header">
            <h4><i data-lucide="bot" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>AI评审结果</h4>
          </div>
          <div class="card-body">
            <div class="grid grid-2 gap-4 mb-4">
              <div>
                <strong>AI评分：</strong>
                <span class="score-badge score-${getScoreLevel(material.aiScore)}">${material.aiScore}</span>
              </div>
            </div>
            <div>
              <strong>AI反馈：</strong>
              <div class="mt-2 p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
                ${material.aiFeedback || '暂无反馈'}
              </div>
            </div>
          </div>
        </div>
      ` : ''}
      
      ${material.reviewedBy ? `
        <div class="card mt-4">
          <div class="card-header">
            <h4><i data-lucide="user-check" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>人工评审结果</h4>
          </div>
          <div class="card-body">
            <div class="grid grid-2 gap-4 mb-4">
              <div><strong>评审人：</strong>${material.reviewedByName}</div>
              <div><strong>评审时间：</strong>${material.reviewedAt}</div>
            </div>
            <div>
              <strong>评审意见：</strong>
              <div class="mt-2 p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
                ${material.reviewComment || '暂无意见'}
              </div>
            </div>
          </div>
        </div>
      ` : ''}
    </div>
  `;
  
  showModal('材料详情', content);
}

/**
 * 格式化文件大小
 */
function formatFileSize(bytes) {
  if (bytes === 0) return '0 Bytes';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

/**
 * 获取评分等级
 */
function getScoreLevel(score) {
  if (score >= 90) return 'excellent';
  if (score >= 80) return 'good';
  if (score >= 60) return 'average';
  return 'poor';
}

/**
 * 触发AI评审
 */
async function triggerAiReview(materialId) {
  try {
    // 尝试调用后端API
    if (window.API && window.API.getCurrentUserId()) {
      showToast('正在启动AI评审，请稍候...', 'info');
      
      // 这里可以调用后端API触发AI评审
      // const response = await window.API.AiReviewAPI.triggerReview(materialId);
      
      // 模拟AI评审过程
      setTimeout(() => {
        showToast('AI评审完成', 'success');
        loadMaterials();
      }, 2000);
      
      return;
    }
  } catch (error) {
    console.warn('调用后端API失败，使用本地模拟:', error);
  }
  
  // 本地模拟AI评审
  showToast('正在启动AI评审，请稍候...', 'info');
  
  setTimeout(() => {
    // 模拟AI评分
    const aiScore = Math.floor(Math.random() * 30) + 70; // 70-100分
    const aiFeedback = generateAiFeedback(aiScore);
    
    // 更新本地材料数据
    updateLocalMaterialAiReview(materialId, aiScore, aiFeedback);
    
    showToast('AI评审完成', 'success');
    loadMaterials();
  }, 2000);
}

/**
 * 生成AI反馈
 */
function generateAiFeedback(score) {
  if (score >= 90) {
    return '材料质量优秀，内容完整，结构清晰，符合规范要求。';
  } else if (score >= 80) {
    return '材料质量良好，基本符合要求，但仍有改进空间。';
  } else if (score >= 60) {
    return '材料质量一般，部分内容需要补充完善。';
  } else {
    return '材料质量较差，需要重新修改后提交。';
  }
}

/**
 * 更新本地材料AI评审结果
 */
function updateLocalMaterialAiReview(materialId, aiScore, aiFeedback) {
  let materials = JSON.parse(localStorage.getItem('materials') || '[]');
  const index = materials.findIndex(m => m.id === materialId);
  
  if (index !== -1) {
    materials[index].aiScore = aiScore;
    materials[index].aiFeedback = aiFeedback;
    materials[index].status = 'AI_REVIEWED';
    materials[index].statusName = 'AI已评审';
    localStorage.setItem('materials', JSON.stringify(materials));
  }
}

// 页面加载时初始化材料列表
