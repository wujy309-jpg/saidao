                </button>
              `).join('')}
            </div>
          </div>
          
          <div class="form-group">
            <label>字体大小</label>
            <select class="form-control" onchange="handleFontSizeChange(this.value)">
              <option value="small" ${currentFontSize === 'small' ? 'selected' : ''}>小</option>
              <option value="medium" ${currentFontSize === 'medium' ? 'selected' : ''}>中</option>
              <option value="large" ${currentFontSize === 'large' ? 'selected' : ''}>大</option>
            </select>
          </div>
          
          <div class="form-group">
            <label>布局密度</label>
            <select class="form-control" onchange="handleDensityChange(this.value)">
              <option value="compact" ${currentDensity === 'compact' ? 'selected' : ''}>紧凑</option>
              <option value="normal" ${currentDensity === 'normal' ? 'selected' : ''}>标准</option>
              <option value="relaxed" ${currentDensity === 'relaxed' ? 'selected' : ''}>宽松</option>
            </select>
          </div>
          
          <div class="form-group">
            <label>语言</label>
            <select class="form-control" onchange="changeLanguage(this.value)">
              <option value="zh" ${localStorage.getItem('language') === 'zh' ? 'selected' : ''}>简体中文</option>
              <option value="en" ${localStorage.getItem('language') === 'en' ? 'selected' : ''}>English</option>
              <option value="ja" ${localStorage.getItem('language') === 'ja' ? 'selected' : ''}>日本語</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="bar-chart-2" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>数据统计</h3>
        </div>
        <div class="card-body">
          <div class="grid grid-2 gap-4">
            <div>
              <strong>用户数量：</strong>
              <span>${dataManager.getUsers().length}</span>
            </div>
            <div>
              <strong>任务数量：</strong>
              <span>${dataManager.getTasks().length}</span>
            </div>
            <div>
              <strong>记录数量：</strong>
              <span>${dataManager.getRecords().length}</span>
            </div>
            <div>
              <strong>评价数量：</strong>
              <span>${dataManager.getEvaluations().length}</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="tool" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>系统操作</h3>
        </div>
        <div class="card-body">
          <div class="flex flex-col gap-3">
            <button class="btn btn-outline" onclick="handleResetData()">
              <i data-lucide="refresh-cw" style="width:16px;height:16px;vertical-align:middle;margin-right:4px"></i>重置演示数据
            </button>
            <button class="btn btn-outline" onclick="handleClearCache()">
              <i data-lucide="trash-2" style="width:16px;height:16px;vertical-align:middle;margin-right:4px"></i>清除缓存
            </button>
            <button class="btn btn-outline" onclick="handleExportAllData()">
              <i data-lucide="download" style="width:16px;height:16px;vertical-align:middle;margin-right:4px"></i>导出所有数据
            </button>
          </div>
        </div>
      </div>
    </div>
  `;
}

/**
 * 保存项目设置
 */
function handleSaveProjectSettings(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const settings = Object.fromEntries(formData.entries());
  
  dataManager.updateProjectSettings(settings);
  showToast('项目设置已保存', 'success');
}

/**
 * 处理主题切换
 */
function handleThemeChange(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  localStorage.setItem('theme', theme);
  showToast('主题已切换', 'success');
}

/**
 * 处理主题颜色切换
 */
function handleThemeColorChange(color) {
  document.documentElement.setAttribute('data-theme-color', color);
  localStorage.setItem('themeColor', color);
  showToast('主题颜色已更改', 'success');
  navigateTo('settings');
}

/**
 * 处理字体大小切换
 */
function handleFontSizeChange(size) {
  document.documentElement.setAttribute('data-font-size', size);
  localStorage.setItem('fontSize', size);
  showToast('字体大小已调整', 'success');
}

/**
 * 处理布局密度切换
 */
function handleDensityChange(density) {
  document.documentElement.setAttribute('data-density', density);
  localStorage.setItem('density', density);
  showToast('布局密度已调整', 'success');
}

/**
 * 初始化主题设置
 */
function initThemeSettings() {
  const theme = localStorage.getItem('theme') || 'light';
  const themeColor = localStorage.getItem('themeColor') || 'blue';
  const fontSize = localStorage.getItem('fontSize') || 'medium';
  const density = localStorage.getItem('density') || 'normal';
  
  document.documentElement.setAttribute('data-theme', theme);
  document.documentElement.setAttribute('data-theme-color', themeColor);
  document.documentElement.setAttribute('data-font-size', fontSize);
  document.documentElement.setAttribute('data-density', density);
}

/**
 * 重置数据
 */
function handleResetData() {
  if (confirm('确定要重置所有演示数据吗？这将清除所有本地数据。')) {
    dataManager.resetAllData();
    showToast('数据已重置', 'success');
    location.reload();
  }
}

/**
 * 清除缓存
 */
function handleClearCache() {
  if (confirm('确定要清除缓存吗？')) {
    localStorage.clear();
    showToast('缓存已清除', 'success');
    location.reload();
  }
}

/**
 * 导出所有数据
 */
function handleExportAllData() {
  const data = dataManager.exportData('all');
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `training_system_backup_${new Date().toISOString().split('T')[0]}.json`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('数据已导出', 'success');
}

