/**
 * 软件实训全流程管理与评价系统 - 主应用逻辑
 */

// API数据管理器实例（用于需要后端API的功能）
const apiManager = apiDataManager;

// ==================== 路由配置 ====================
const ROUTES = {
  dashboard: { name: '仪表盘', icon: 'layout-dashboard', render: renderDashboard },
  tasks: { name: '任务管理', icon: 'clipboard-list', render: renderTasks },
  materials: { name: '实训材料', icon: 'folder-open', render: renderMaterials },
  records: { name: '过程记录', icon: 'file-text', render: renderRecords },
  evaluate: { name: '评价系统', icon: 'star', render: renderEvaluate },
  flow: { name: '流程管理', icon: 'git-branch', render: renderFlow },
  codeRepos: { name: '代码仓库', icon: 'folder-git-2', render: renderCodeRepoPage },
  notifications: { name: '通知消息', icon: 'bell', render: renderNotifications },
  activityLog: { name: '活动日志', icon: 'activity', render: renderActivityLog },
  users: { name: '用户管理', icon: 'users', render: renderUsers, permission: 'user_manage' },
  settings: { name: '系统配置', icon: 'settings', render: renderSettings, permission: 'system_config' },
  export: { name: '数据导出', icon: 'download', render: renderExport, permission: 'data_export' }
};

// ==================== 全局状态 ====================
const appState = {
  tabs: [],
  activeTab: null,
  sidebarCollapsed: false
};

// ==================== 初始化 ====================

document.addEventListener('DOMContentLoaded', function() {
  initTheme();
  initLanguage();
  initLanguageMenuClose();
  initUserMenuClose();
  initGlobalSearchShortcuts();
  initSidebarState();
  initKeyboardShortcuts();
  initOfflineDetection();
  checkAuthState();
  // 初始化 Lucide 图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
});

/**
 * 初始化键盘快捷键
 */
function initKeyboardShortcuts() {
  document.addEventListener('keydown', function(event) {
    // Ctrl/Cmd + K - 打开搜索
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      const searchInput = document.getElementById('global-search-input');
      if (searchInput) {
        searchInput.focus();
        searchInput.select();
      }
    }
    
    // Ctrl/Cmd + B - 切换侧边栏
    if ((event.metaKey || event.ctrlKey) && event.key === 'b') {
      event.preventDefault();
      toggleSidebar();
    }
    
    // Ctrl/Cmd + N - 新建任务（如果有权限）
    if ((event.metaKey || event.ctrlKey) && event.key === 'n') {
      event.preventDefault();
      if (dataManager.hasPermission('task_create')) {
        showCreateTaskModal();
      }
    }
    
    // Escape - 关闭弹窗/搜索
    if (event.key === 'Escape') {
      // 关闭搜索结果
      hideSearchResults();
      
      // 关闭模态框
      const modal = document.getElementById('modal-container');
      if (modal && modal.innerHTML) {
        closeModal();
      }
      
      // 关闭用户菜单
      const userMenu = document.getElementById('user-menu');
      if (userMenu && userMenu.classList.contains('show')) {
        userMenu.classList.remove('show');
      }
    }
    
    // 数字快捷键 - 导航到对应页面
    if (event.altKey && !event.ctrlKey && !event.metaKey) {
      const shortcuts = {
        '1': 'dashboard',
        '2': 'tasks',
        '3': 'materials',
        '4': 'records',
        '5': 'evaluate',
        '6': 'notifications'
      };
      
      if (shortcuts[event.key]) {
        event.preventDefault();
        navigateTo(shortcuts[event.key]);
      }
    }
  });
  
  // 显示快捷键提示（首次访问时）
  showShortcutHints();
}

/**
 * 显示快捷键提示
 */
function showShortcutHints() {
  const hasSeenHints = localStorage.getItem('hasSeenShortcutHints');
  if (hasSeenHints) return;
  
  // 延迟显示，避免影响初始加载
  setTimeout(() => {
    const hints = document.createElement('div');
    hints.className = 'keyboard-shortcuts';
    hints.id = 'keyboard-shortcuts';
    hints.innerHTML = `
      <div class="shortcut-hint">
        <span class="shortcut-key">⌘K</span>
        <span>搜索</span>
      </div>
      <div class="shortcut-hint">
        <span class="shortcut-key">⌘B</span>
        <span>侧边栏</span>
      </div>
      <div class="shortcut-hint">
        <span class="shortcut-key">Alt+1-6</span>
        <span>导航</span>
      </div>
    `;
    document.body.appendChild(hints);
    
    // 5秒后自动隐藏
    setTimeout(() => {
      hints.style.opacity = '0';
      hints.style.transform = 'translateY(10px)';
      setTimeout(() => hints.remove(), 300);
    }, 5000);
    
    localStorage.setItem('hasSeenShortcutHints', 'true');
  }, 2000);
}

/**
 * 初始化离线检测
 */
function initOfflineDetection() {
  // 监听在线/离线状态
  window.addEventListener('online', function() {
    hideOfflineIndicator();
    showToast('网络已恢复连接', 'success');
  });
  
  window.addEventListener('offline', function() {
    showOfflineIndicator();
    showToast('网络连接已断开，部分功能可能不可用', 'warning');
  });
  
  // 初始检查
  if (!navigator.onLine) {
    showOfflineIndicator();
  }
}

function showOfflineIndicator() {
  // 移除现有的指示器
  hideOfflineIndicator();
  
  const indicator = document.createElement('div');
  indicator.id = 'offline-indicator';
  indicator.className = 'offline-indicator';
  indicator.innerHTML = `
    <i data-lucide="wifi-off"></i>
    <span>网络连接已断开</span>
  `;
  document.body.appendChild(indicator);
  
  // 渲染图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

function hideOfflineIndicator() {
  const indicator = document.getElementById('offline-indicator');
  if (indicator) {
    indicator.remove();
  }
}

/**
 * 初始化侧边栏状态
 */
function initSidebarState() {
  const collapsed = localStorage.getItem('sidebarCollapsed') === 'true';
  if (collapsed) {
    toggleSidebar();
  }
}

/**
 * 初始化语言菜单关闭事件
 */
function initLanguageMenuClose() {
  document.addEventListener('click', function(event) {
    const langMenu = document.getElementById('lang-menu');
    const langToggle = document.querySelector('.lang-toggle');
    
    if (langMenu && langMenu.classList.contains('show')) {
      if (!langMenu.contains(event.target) && !langToggle.contains(event.target)) {
        langMenu.classList.remove('show');
      }
    }
  });
}

/**
 * 初始化用户菜单关闭事件
 */
function initUserMenuClose() {
  document.addEventListener('click', function(event) {
    const userMenu = document.getElementById('user-menu');
    const userToggle = document.querySelector('.user-toggle');
    
    if (userMenu && userMenu.classList.contains('show')) {
      if (!userMenu.contains(event.target) && !userToggle.contains(event.target)) {
        userMenu.classList.remove('show');
      }
    }
  });
}

/**
 * 初始化全局搜索快捷键
 */
function initGlobalSearchShortcuts() {
  document.addEventListener('keydown', function(event) {
    // Cmd+K 或 Ctrl+K 打开搜索
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      const searchInput = document.getElementById('global-search-input');
      if (searchInput) {
        searchInput.focus();
      }
    }
    
    // ESC 关闭搜索
    if (event.key === 'Escape') {
      const searchInput = document.getElementById('global-search-input');
      if (searchInput === document.activeElement) {
        searchInput.blur();
        searchInput.value = '';
      }
    }
  });
}

/**
 * 全局搜索处理
 */
let searchTimeout = null;

function handleGlobalSearch(query) {
  // 清除之前的定时器
  if (searchTimeout) {
    clearTimeout(searchTimeout);
  }
  
  // 如果查询为空，隐藏搜索结果
  if (!query.trim()) {
    hideSearchResults();
    return;
  }
  
  // 延迟搜索，避免频繁请求
  searchTimeout = setTimeout(() => {
    performGlobalSearch(query);
  }, 300);
}

function performGlobalSearch(query) {
  const results = [];
  const lowerQuery = query.toLowerCase();
  
  // 搜索路由
  for (const [key, route] of Object.entries(ROUTES)) {
    if (route.name.toLowerCase().includes(lowerQuery)) {
      results.push({ 
        type: 'page',
        key, 
        name: route.name, 
        icon: route.icon,
        description: `导航到 ${route.name}`
      });
    }
  }
  
  // 搜索任务
  const tasks = dataManager.getTasks();
  tasks.forEach(task => {
    if (task.title.toLowerCase().includes(lowerQuery) || 
        task.description?.toLowerCase().includes(lowerQuery)) {
      results.push({
        type: 'task',
        id: task.id,
        name: task.title,
        icon: 'clipboard-list',
        description: `任务 - ${getStatusText(task.status)}`,
        action: () => showTaskDetail(task.id)
      });
    }
  });
  
  // 搜索用户
  const users = dataManager.getUsers();
  users.forEach(user => {
    if (user.name.toLowerCase().includes(lowerQuery) || 
        user.username.toLowerCase().includes(lowerQuery)) {
      results.push({
        type: 'user',
        id: user.id,
        name: user.name,
        icon: 'user',
        description: `${getRoleName(user.role)} - ${user.email}`,
        action: () => navigateTo('users')
      });
    }
  });
  
  // 显示搜索结果
  showSearchResults(results, query);
}

function showSearchResults(results, query) {
  // 移除现有的搜索结果
  hideSearchResults();
  
  if (results.length === 0) {
    showToast(`未找到与"${query}"相关的结果`, 'info');
    return;
  }
  
  // 创建搜索结果容器
  const container = document.createElement('div');
  container.id = 'search-results';
  container.className = 'search-results';
  container.innerHTML = `
    <div class="search-results-header">
      <span>找到 ${results.length} 个结果</span>
      <button class="btn btn-ghost btn-sm" onclick="hideSearchResults()">
        <i data-lucide="x" style="width:14px;height:14px"></i>
      </button>
    </div>
    <div class="search-results-list">
      ${results.slice(0, 10).map((result, index) => `
        <div class="search-result-item ${index === 0 ? 'active' : ''}" 
             onclick="handleSearchResultClick(${index})" 
             data-index="${index}">
          <div class="search-result-icon">
            <i data-lucide="${result.icon}" style="width:16px;height:16px"></i>
          </div>
          <div class="search-result-info">
            <div class="search-result-name">${highlightMatch(result.name, query)}</div>
            <div class="search-result-desc">${result.description}</div>
          </div>
          <div class="search-result-type">${getTypeLabel(result.type)}</div>
        </div>
      `).join('')}
    </div>
    ${results.length > 10 ? `
      <div class="search-results-footer">
        还有 ${results.length - 10} 个结果...
      </div>
    ` : ''}
  `;
  
  // 添加到搜索框下方
  const searchBox = document.querySelector('.global-search');
  searchBox.appendChild(container);
  
  // 渲染图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // 保存结果供点击使用
  window.searchResults = results;
}

function hideSearchResults() {
  const existing = document.getElementById('search-results');
  if (existing) {
    existing.remove();
  }
}

function handleSearchResultClick(index) {
  const result = window.searchResults[index];
  if (!result) return;
  
  hideSearchResults();
  
  if (result.action) {
    result.action();
  } else if (result.key) {
    navigateTo(result.key);
  }
  
  // 清空搜索框
  const searchInput = document.getElementById('global-search-input');
  if (searchInput) {
    searchInput.value = '';
  }
}

function highlightMatch(text, query) {
  if (!query) return text;
  const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
  return text.replace(regex, '<mark>$1</mark>');
}

function getTypeLabel(type) {
  const labels = {
    'page': '页面',
    'task': '任务',
    'user': '用户',
    'project': '项目'
  };
  return labels[type] || type;
}

function getRoleName(role) {
  const roleNames = {
    'admin': '管理员',
    'teacher': '教师',
    'student': '学生',
    'enterprise': '企业导师'
  };
  return roleNames[role] || role;
}

/**
 * 切换用户菜单
 */
function toggleUserMenu() {
  const menu = document.getElementById('user-menu');
  if (menu) {
    menu.classList.toggle('show');
  }
}

// ==================== 语言切换 ====================

/**
 * 初始化语言
 */
function initLanguage() {
  const savedLang = localStorage.getItem('language') || 'zh';
  i18n.setLanguage(savedLang);
  updateLanguageUI(savedLang);
}

/**
 * 切换语言
 * @param {string} lang - 语言代码 (zh/en/ja)
 */
function changeLanguage(lang) {
  i18n.setLanguage(lang);
  updateLanguageUI(lang);
  
  // 重新渲染当前页面
  const activeLink = document.querySelector('.nav-link.active');
  if (activeLink) {
    const routeName = activeLink.dataset.route;
    navigateTo(routeName);
  }
  
  // 更新导航栏文本
  updateNavbarTexts();
}

/**
 * 更新语言UI状态
 * @param {string} lang - 当前语言代码
 */
function updateLanguageUI(lang) {
  // 更新登录页面的语言按钮
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });
  
  // 更新用户菜单的语言按钮
  document.querySelectorAll('.user-menu-lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });
  
  // 更新当前语言显示
  const currentLangEl = document.getElementById('current-lang');
  if (currentLangEl) {
    currentLangEl.textContent = i18n.getLanguageName(lang);
  }
}

/**
 * 切换语言菜单显示
 */
function toggleLanguageMenu() {
  const menu = document.getElementById('lang-menu');
  if (menu) {
    menu.classList.toggle('show');
  }
}

/**
 * 更新导航栏文本
 */
function updateNavbarTexts() {
  const navItems = document.querySelectorAll('.nav-link');
  navItems.forEach(item => {
    const routeName = item.dataset.route;
    const route = ROUTES[routeName];
    if (route) {
      // 根据路由名称获取翻译键
      const translationKey = getNavTranslationKey(routeName);
      const spanElements = item.querySelectorAll('span');
      if (spanElements.length >= 2) {
        spanElements[1].textContent = i18n.t(translationKey);
      }
    }
  });
}

/**
 * 获取导航项翻译键
 * @param {string} routeName - 路由名称
 * @returns {string} 翻译键
 */
function getNavTranslationKey(routeName) {
  const keyMap = {
    dashboard: 'navDashboard',
    tasks: 'navTasks',
    materials: 'navMaterials',
    records: 'navRecords',
    evaluate: 'navEvaluate',
    flow: 'navFlow',
    codeRepos: 'navCodeRepos',
    users: 'navUsers',
    settings: 'navSettings',
    export: 'navExport',
    notifications: 'navNotifications'
  };
  return keyMap[routeName] || routeName;
}

// ==================== 主题切换 ====================

/**
 * 初始化主题
 */
function initTheme() {
  initThemeSettings();
  updateThemeIcon(localStorage.getItem('theme') || 'light');
}

/**
 * 切换主题
 */
function toggleTheme() {
  const html = document.documentElement;
  const currentTheme = html.getAttribute('data-theme');
  const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', newTheme);
  localStorage.setItem('theme', newTheme);
  updateThemeIcon(newTheme);
  // 重新渲染当前页面以更新图表颜色
  const activeLink = document.querySelector('.nav-link.active');
  if (activeLink) {
    const routeName = activeLink.dataset.route;
    if (routeName === 'dashboard') {
      navigateTo('dashboard');
    }
  }
}

/**
 * 更新主题图标
 */
function updateThemeIcon(theme) {
  const icon = document.querySelector('.theme-icon');
  if (icon) {
    // 更新 Lucide 图标
    icon.setAttribute('data-lucide', theme === 'dark' ? 'sun' : 'moon');
    // 重新渲染图标
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
}

/**
 * 检查认证状态
 */
function checkAuthState() {
  const user = dataManager.getCurrentUser();
  
  if (user) {
    showMainApp(user);
    navigateTo('dashboard');
  } else {
    showLoginPage();
  }
}

/**
 * 显示登录页面
 */
function showLoginPage() {
  document.getElementById('login-page').classList.remove('hidden');
  document.getElementById('main-app').classList.add('hidden');
}

/**
 * 显示主应用
 */
function showMainApp(user) {
  document.getElementById('login-page').classList.add('hidden');
  document.getElementById('main-app').classList.remove('hidden');
  updateNavbar(user);
  updateNotificationCount(user.id);
}

/**
 * 更新通知数量
 */
function updateNotificationCount(userId) {
  try {
    const unreadCount = dataManager.getUnreadCount(userId);
    const badge = document.getElementById('notification-count');
    if (badge) {
      if (unreadCount > 0) {
        badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
        badge.style.display = 'flex';
      } else {
        badge.style.display = 'none';
      }
    }
  } catch (error) {
    console.error('更新通知数量失败:', error);
  }
}

/**
 * 更新导航栏
 */
function updateNavbar(user) {
  const nav = document.getElementById('navbar-nav');
  const roleName = dataManager.getRoleName(user.role) || ROLE_PERMISSIONS[user.role]?.name || user.role;
  
  // 更新顶部栏用户信息
  document.getElementById('current-user-name').textContent = user.name;
  document.getElementById('current-user-role').textContent = roleName;
  
  // 更新侧边栏用户信息
  const sidebarUserName = document.getElementById('sidebar-user-name');
  const sidebarUserRole = document.getElementById('sidebar-user-role');
  if (sidebarUserName) sidebarUserName.textContent = user.name;
  if (sidebarUserRole) sidebarUserRole.textContent = roleName;
  
  // 更新用户头像
  const userAvatar = document.getElementById('user-avatar');
  const sidebarUserAvatar = document.getElementById('sidebar-user-avatar');
  if (userAvatar) userAvatar.textContent = user.name.charAt(0).toUpperCase();
  if (sidebarUserAvatar) sidebarUserAvatar.textContent = user.name.charAt(0).toUpperCase();
  
  // 更新用户菜单头部
  const userMenuAvatar = document.getElementById('user-menu-avatar');
  const userMenuName = document.getElementById('user-menu-name');
  const userMenuEmail = document.getElementById('user-menu-email');
  if (userMenuAvatar) userMenuAvatar.textContent = user.name.charAt(0).toUpperCase();
  if (userMenuName) userMenuName.textContent = user.name;
  if (userMenuEmail) userMenuEmail.textContent = user.email || user.username;

  let navHtml = '';
  for (const [key, route] of Object.entries(ROUTES)) {
    if (route.permission && !dataManager.hasPermission(route.permission)) {
      continue;
    }
    navHtml += `
      <li class="nav-item">
        <a class="nav-link" href="#" data-route="${key}" onclick="navigateTo('${key}')">
          <i data-lucide="${route.icon}"></i>
          <span>${route.name}</span>
        </a>
      </li>
    `;
  }
  nav.innerHTML = navHtml;
  // 渲染 Lucide 图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

// ==================== 路由导航 ====================

/**
 * 导航到指定页面
 */
function navigateTo(routeName) {
  const route = ROUTES[routeName];
  if (!route) return;

  // 检查权限
  if (route.permission && !dataManager.hasPermission(route.permission)) {
    showToast('没有权限访问此页面', 'error');
    return;
  }

  // 更新导航激活状态
  document.querySelectorAll('.nav-link').forEach(link => {
    link.classList.remove('active');
    if (link.dataset.route === routeName) {
      link.classList.add('active');
    }
  });

  // 添加标签页
  addTab(routeName);

  // 渲染页面内容
  const mainContent = document.getElementById('main-content');
  mainContent.innerHTML = route.render();
  
  // 添加淡入动画
  mainContent.classList.remove('page-enter');
  void mainContent.offsetWidth; // 触发重绘
  mainContent.classList.add('page-enter');
  
  // 更新面包屑
  updateBreadcrumb(routeName);
  
  // 渲染页面中的 Lucide 图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // 更新通知数量
  const currentUser = dataManager.getCurrentUser();
  if (currentUser) {
    updateNotificationCount(currentUser.id);
  }
  
  // 特定页面的数据加载
  if (routeName === 'materials') {
    setTimeout(() => loadMaterials(), 100);
  }
  if (routeName === 'notifications') {
    setTimeout(() => loadNotifications(), 100);
  }
  
  // 初始化滚动动画
  requestAnimationFrame(() => {
    initScrollReveal();
  });
  
  // 关闭移动端菜单
  closeMobileMenu();
}

/**
 * 更新面包屑导航
 */
function updateBreadcrumb(routeName) {
  const breadcrumb = document.getElementById('breadcrumb');
  if (!breadcrumb) return;
  
  const route = ROUTES[routeName];
  if (!route) return;
  
  breadcrumb.innerHTML = `
    <span class="breadcrumb-item">
      <i data-lucide="home" style="width:14px;height:14px"></i>
    </span>
    <span class="breadcrumb-separator">/</span>
    <span class="breadcrumb-item active">${route.name}</span>
  `;
  
  // 重新渲染图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

// ==================== 登录处理 ====================

/**
 * 处理登录
 */
async function handleLogin(event) {
  event.preventDefault();
  const username = document.getElementById('username').value;
  const password = document.getElementById('password').value;
  const errorEl = document.getElementById('login-error');
  const loginBtn = document.querySelector('.login-btn');

  // 清除之前的错误
  errorEl.classList.add('hidden');
  
  // 添加加载状态
  loginBtn.classList.add('loading');
  loginBtn.disabled = true;

  try {
    // 使用核心数据管理器登录
    const response = dataManager.login(username, password);
    
    if (response.success && response.data) {
      errorEl.classList.add('hidden');
      
      // 添加登录成功动画
      const loginContainer = document.querySelector('.login-container');
      loginContainer.classList.add('animate-scale-out');
      
      setTimeout(() => {
        showMainApp(response.data);
        navigateTo('dashboard');
        showToast('登录成功', 'success');
      }, 300);
    } else {
      errorEl.textContent = response.message || '用户名或密码错误';
      errorEl.classList.remove('hidden');
      loginBtn.classList.remove('loading');
      loginBtn.disabled = false;
      
      // 添加抖动动画
      const loginContainer = document.querySelector('.login-container');
      loginContainer.classList.add('animate-shake');
      setTimeout(() => loginContainer.classList.remove('animate-shake'), 500);
    }
  } catch (error) {
    console.error('登录错误:', error);
    errorEl.textContent = '登录失败，请重试';
    errorEl.classList.remove('hidden');
    loginBtn.classList.remove('loading');
    loginBtn.disabled = false;
  }
}

/**
 * 处理登出
 */
function handleLogout() {
  dataManager.logout();
  showLoginPage();
  showToast('已退出登录', 'info');
}

// ==================== 工具函数 ====================

/**
 * 显示提示消息（增强版）
 */
function showToast(message, type = 'info', options = {}) {
  const container = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  
  const icons = { 
    success: 'check-circle', 
    error: 'x-circle', 
    warning: 'alert-triangle', 
    info: 'info' 
  };
  
  // 支持自定义持续时间
  const duration = options.duration || 3000;
  const showProgress = options.progress !== false;
  
  toast.innerHTML = `
    <i data-lucide="${icons[type] || icons.info}" class="toast-icon"></i>
    <div class="toast-content">
      <span class="toast-message">${message}</span>
      ${options.description ? `<span class="toast-description">${options.description}</span>` : ''}
    </div>
    <button class="toast-close" onclick="dismissToast(this.parentElement)">
      <i data-lucide="x" style="width:14px;height:14px"></i>
    </button>
    ${showProgress ? `<div class="toast-progress" style="animation-duration: ${duration}ms"></div>` : ''}
  `;
  
  container.appendChild(toast);
  
  // 渲染 Lucide 图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
  
  // 自动关闭
  const dismissTimer = setTimeout(() => {
    dismissToast(toast);
  }, duration);
  
  // 鼠标悬停时暂停自动关闭
  toast.addEventListener('mouseenter', function() {
    clearTimeout(dismissTimer);
    const progress = toast.querySelector('.toast-progress');
    if (progress) {
      progress.style.animationPlayState = 'paused';
    }
  });
  
  toast.addEventListener('mouseleave', function() {
    const progress = toast.querySelector('.toast-progress');
    if (progress) {
      progress.style.animationPlayState = 'running';
    }
    setTimeout(() => dismissToast(toast), 1000);
  });
  
  return toast;
}

/**
 * 关闭Toast
 */
function dismissToast(toast) {
  if (!toast || toast.classList.contains('hiding')) return;
  toast.classList.add('hiding');
  setTimeout(() => toast.remove(), 300);
}

/**
 * 显示确认对话框（增强版）
 */
function showConfirmDialog(title, message, options = {}) {
  return new Promise((resolve) => {
    const container = document.getElementById('modal-container');
    const confirmText = options.confirmText || '确定';
    const cancelText = options.cancelText || '取消';
    const type = options.type || 'primary';
    const icon = options.icon || 'help-circle';
    
    container.innerHTML = `
      <div class="modal-overlay active" onclick="closeConfirmDialog(false)">
        <div class="modal confirm-dialog" onclick="event.stopPropagation()">
          <div class="modal-header">
            <h3>
              <i data-lucide="${icon}" style="width:20px;height:20px;vertical-align:middle;margin-right:8px;color:var(--${type === 'danger' ? 'red' : type === 'warning' ? 'amber' : 'blue'}-600)"></i>
              ${title}
            </h3>
          </div>
          <div class="modal-body">
            <p>${message}</p>
            ${options.details ? `
              <div class="confirm-details">
                ${options.details}
              </div>
            ` : ''}
          </div>
          <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeConfirmDialog(false)">${cancelText}</button>
            <button class="btn btn-${type}" onclick="closeConfirmDialog(true)">${confirmText}</button>
          </div>
        </div>
      </div>
    `;
    
    // 渲染图标
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
    
    // 保存resolve函数
    window.confirmDialogResolve = resolve;
  });
}

/**
 * 关闭确认对话框
 */
function closeConfirmDialog(confirmed) {
  const modal = document.querySelector('.confirm-dialog');
  if (modal) {
    modal.closest('.modal-overlay').remove();
  }
  if (window.confirmDialogResolve) {
    window.confirmDialogResolve(confirmed);
    window.confirmDialogResolve = null;
  }
}

/**
 * 显示加载状态
 */
function showLoading(message = '加载中...') {
  const overlay = document.createElement('div');
  overlay.id = 'global-loading';
  overlay.className = 'loading-overlay-global';
  overlay.innerHTML = `
    <div class="loading-spinner">
      <div class="spinner"></div>
      <p>${message}</p>
    </div>
  `;
  document.body.appendChild(overlay);
}

/**
 * 隐藏加载状态
 */
function hideLoading() {
  const overlay = document.getElementById('global-loading');
  if (overlay) {
    overlay.classList.add('hiding');
    setTimeout(() => overlay.remove(), 300);
  }
}

/**
 * 显示输入对话框
 */
function showInputPrompt(title, placeholder, defaultValue = '') {
  return new Promise((resolve) => {
    const container = document.getElementById('modal-container');
    
    container.innerHTML = `
      <div class="modal-overlay active" onclick="closeInputPrompt(null)">
        <div class="modal" onclick="event.stopPropagation()">
          <div class="modal-header">
            <h3>${title}</h3>
            <button class="modal-close" onclick="closeInputPrompt(null)">&times;</button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <input type="text" class="form-control" id="prompt-input" 
                     placeholder="${placeholder}" value="${defaultValue}"
                     onkeydown="if(event.key==='Enter')closeInputPrompt(this.value)">
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeInputPrompt(null)">取消</button>
            <button class="btn btn-primary" onclick="closeInputPrompt(document.getElementById('prompt-input').value)">确定</button>
          </div>
        </div>
      </div>
    `;
    
    // 聚焦输入框
    setTimeout(() => {
      const input = document.getElementById('prompt-input');
      if (input) {
        input.focus();
        input.select();
      }
    }, 100);
    
    window.inputPromptResolve = resolve;
  });
}

/**
 * 关闭输入对话框
 */
function closeInputPrompt(value) {
  const modal = document.querySelector('.modal-overlay');
  if (modal) {
    modal.remove();
  }
  if (window.inputPromptResolve) {
    window.inputPromptResolve(value);
    window.inputPromptResolve = null;
  }
}

/**
 * 显示模态框
 */
function showModal(title, content, onConfirm = null) {
  const container = document.getElementById('modal-container');
  container.innerHTML = `
    <div class="modal-overlay active" onclick="closeModal(event)">
      <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
          <h3>${title}</h3>
          <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body">${content}</div>
        <div class="modal-footer">
          ${onConfirm ? `
            <button class="btn btn-outline" onclick="closeModal()">取消</button>
            <button class="btn btn-primary" onclick="${onConfirm}">确定</button>
          ` : `
            <button class="btn btn-outline" onclick="closeModal()">关闭</button>
          `}
        </div>
      </div>
    </div>
  `;
  
  // 渲染图标
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

/**
 * 关闭模态框
 */
function closeModal(event) {
  if (event && event.target !== event.currentTarget) return;
  const modal = document.querySelector('.modal-overlay');
  if (modal) {
    modal.classList.add('hiding');
    setTimeout(() => {
      document.getElementById('modal-container').innerHTML = '';
    }, 200);
  }
}

/**
 * 格式化日期
 */
function formatDate(dateStr) {
  if (!dateStr) return '-';
  
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now - date;
  
  // 如果是今天
  if (diff < 86400000 && date.getDate() === now.getDate()) {
    return `今天 ${date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`;
  }
  
  // 如果是昨天
  const yesterday = new Date(now);
  yesterday.setDate(yesterday.getDate() - 1);
  if (date.getDate() === yesterday.getDate() && date.getMonth() === yesterday.getMonth()) {
    return `昨天 ${date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`;
  }
  
  // 其他情况
  return date.toLocaleDateString('zh-CN', { 
    month: 'short', 
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

/**
 * 获取用户显示名称
 */
function getUserName(userId) {
  const user = dataManager.getUserById(userId);
  return user ? user.name : '未知用户';
}

/**
 * 获取状态标签HTML
 */
function getStatusBadge(status) {
  const text = TASK_STATUS_TEXT[status] || status;
  return `<span class="badge badge-${status}">${text}</span>`;
}

/**
 * 获取优先级标签HTML
 */
function getPriorityBadge(priority) {
  const text = { high: '高', medium: '中', low: '低' }[priority] || priority;
  return `<span class="badge badge-${priority}">${text}</span>`;
}

// ==================== 仪表盘页面 ====================

function renderDashboard() {
  const currentUser = dataManager.getCurrentUser();
  const projects = dataManager.getProjects();
  const project = projects[0]; // 演示用第一个项目
  
  let tasks, stats, records, evaluations;
  
  if (project) {
    tasks = dataManager.getTasks({ projectId: project.id });
    stats = dataManager.getTaskStatistics(project.id);
    records = dataManager.getRecords({ userId: currentUser.id, projectId: project.id });
    
    if (currentUser.role === ROLES.STUDENT) {
      evaluations = dataManager.getEvaluations({ evaluateeId: currentUser.id, projectId: project.id });
    }
  }

  // 延迟初始化图表
  setTimeout(() => {
    if (stats) renderDashboardCharts(stats, records || []);
    renderDashboardECharts(stats, records || []);
  }, 100);

  return `
    <div class="page-header">
      <h1><i data-lucide="layout-dashboard" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>工作台</h1>
      <div class="subtitle">欢迎回来，${currentUser.name}</div>
    </div>

    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="clipboard-list"></i></div>
        <div class="info">
          <h3>${stats ? stats.total : 0}</h3>
          <p>任务总数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon green"><i data-lucide="check-circle"></i></div>
        <div class="info">
          <h3>${stats ? stats.completionRate : 0}%</h3>
          <p>完成率</p>
          <div class="trend-indicator up">
            <i data-lucide="trending-up"></i>
            <span>+12%</span>
          </div>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="file-text"></i></div>
        <div class="info">
          <h3>${records ? records.length : 0}</h3>
          <p>工作记录</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon purple"><i data-lucide="star"></i></div>
        <div class="info">
          <h3>${evaluations && evaluations.length > 0 ? evaluations[0].totalScore : '-'}</h3>
          <p>综合评分</p>
        </div>
      </div>
    </div>

    <div class="dashboard-charts">
      <div class="chart-card">
        <h3><i data-lucide="pie-chart" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>任务状态分布</h3>
        <div class="chart-container" id="task-status-chart"></div>
      </div>
      <div class="chart-card">
        <h3><i data-lucide="bar-chart" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>工作时长统计</h3>
        <div class="chart-container" id="work-hours-chart"></div>
      </div>
    </div>

    <div class="dashboard-bottom">
      ${typeof renderPendingItems === 'function' ? renderPendingItems() : ''}
      
      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="clipboard-list" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>待办任务</h3>
          <a href="#" onclick="navigateTo('tasks')">查看全部</a>
        </div>
        <div class="card-body">
          ${renderPendingTasks(currentUser)}
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="file-text" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>最近记录</h3>
          <a href="#" onclick="navigateTo('records')">查看全部</a>
        </div>
        <div class="card-body">
          ${renderRecentRecords(currentUser)}
        </div>
      </div>
    </div>

    <!-- Activity Timeline -->
    <div class="card mt-6">
      <div class="card-header">
        <h3><i data-lucide="activity" style="width:18px;height:18px"></i>最近活动</h3>
        <button class="btn btn-ghost btn-sm" onclick="navigateTo('activityLog')">查看全部</button>
      </div>
      <div class="card-body">
        ${renderActivityTimeline(currentUser)}
      </div>
    </div>

    ${project ? `
      <div class="card mt-6">
        <div class="card-header">
          <h3><i data-lucide="git-branch" style="width:18px;height:18px"></i>项目进度 - ${project.name}</h3>
        </div>
        <div class="card-body">
          ${renderProjectProgress(project)}
        </div>
      </div>
    ` : ''}
  `;
}

/**
 * 渲染活动时间线
 */
function renderActivityTimeline(user) {
  const activities = getRecentActivities(user);
  
  if (activities.length === 0) {
    return `
      <div class="empty-state" style="padding: var(--space-8);">
        <div class="empty-icon">
          <i data-lucide="activity"></i>
        </div>
        <h4 class="empty-title">暂无活动记录</h4>
        <p class="empty-desc">开始使用系统后，这里将显示您的最近活动</p>
      </div>
    `;
  }

  return `
    <div class="activity-timeline">
      ${activities.map((activity, index) => `
        <div class="timeline-item ${index === 0 ? 'latest' : ''}">
          <div class="timeline-dot ${activity.type}"></div>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="timeline-title">${activity.title}</span>
              <span class="timeline-time">${activity.time}</span>
            </div>
            <p class="timeline-desc">${activity.description}</p>
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

/**
 * 获取最近活动
 */
function getRecentActivities(user) {
  const activities = [];
  
  // 获取最近的任务活动
  const tasks = dataManager.getTasks({ assigneeId: user.id });
  tasks.slice(0, 3).forEach(task => {
    activities.push({
      type: 'task',
      title: `任务: ${task.title}`,
      description: `状态: ${getStatusText(task.status)}`,
      time: getRelativeTime(task.updatedAt || task.createdAt),
      timestamp: new Date(task.updatedAt || task.createdAt)
    });
  });

  // 获取最近的记录
  const records = dataManager.getRecords({ userId: user.id });
  records.slice(0, 2).forEach(record => {
    activities.push({
      type: 'record',
      title: `工作记录: ${record.title || '新记录'}`,
      description: record.content?.substring(0, 50) + '...' || '',
      time: getRelativeTime(record.createdAt),
      timestamp: new Date(record.createdAt)
    });
  });

  // 按时间排序
  activities.sort((a, b) => b.timestamp - a.timestamp);
  
  return activities.slice(0, 5);
}

/**
 * 获取状态文本
 */
function getStatusText(status) {
  const statusMap = {
    'pending': '待开始',
    'in_progress': '进行中',
    'submitted': '已提交',
    'reviewing': '审核中',
    'approved': '已通过',
    'rejected': '已驳回',
    'completed': '已完成'
  };
  return statusMap[status] || status;
}

/**
 * 获取相对时间
 */
function getRelativeTime(dateStr) {
  if (!dateStr) return '刚刚';
  
  const date = new Date(dateStr);
  const now = new Date();
  const diff = now - date;
  
  const minutes = Math.floor(diff / 60000);
  const hours = Math.floor(diff / 3600000);
  const days = Math.floor(diff / 86400000);
  
  if (minutes < 1) return '刚刚';
  if (minutes < 60) return `${minutes}分钟前`;
  if (hours < 24) return `${hours}小时前`;
  if (days < 7) return `${days}天前`;
  
  return date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric' });
}

/**
 * 刷新仪表盘
 */
function refreshDashboard() {
  showToast('正在刷新数据...', 'info');
  navigateTo('dashboard');
  
  // 更新时间显示
  setTimeout(() => {
    const timeEl = document.getElementById('last-update-time');
    if (timeEl) {
      timeEl.textContent = `更新于 ${new Date().toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' })}`;
    }
  }, 100);
}

/**
 * 初始化仪表盘动画
 */
function initDashboardAnimations() {
  // 为统计卡片添加计数动画
  document.querySelectorAll('.stat-card h3').forEach(el => {
    el.classList.add('count-up');
  });
  
  // 为快捷操作添加悬停效果
  document.querySelectorAll('.quick-action-card').forEach(el => {
    el.addEventListener('mouseenter', function() {
      this.style.transform = 'translateY(-4px)';
    });
    el.addEventListener('mouseleave', function() {
      this.style.transform = 'translateY(0)';
    });
  });
}

/**
 * 渲染仪表盘图表
 */
function renderDashboardCharts(stats, records) {
  const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
  const textColor = isDark ? '#cbd5e1' : '#475569';
  const gridColor = isDark ? 'rgba(51, 65, 85, 0.5)' : 'rgba(226, 232, 240, 0.8)';

  // 任务状态分布 - 环形图 (使用Chart.js)
  const taskCtx = document.getElementById('taskChart');
  if (taskCtx) {
    new Chart(taskCtx.getContext('2d'), {
      type: 'doughnut',
      data: {
        labels: ['待开始', '进行中', '已提交', '审核中', '已通过', '已完成'],
        datasets: [{
          data: [
            stats.pending || 0,
            stats.in_progress || 0,
            stats.submitted || 0,
            stats.reviewing || 0,
            stats.approved || 0,
            stats.completed || 0
          ],
          backgroundColor: [
            '#94a3b8',
            '#3b82f6',
            '#f59e0b',
            '#a855f7',
            '#22c55e',
            '#06b6d4'
          ],
          borderWidth: 0,
          borderRadius: 4,
          spacing: 3,
          hoverOffset: 8
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '68%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              padding: 16,
              usePointStyle: true,
              pointStyleWidth: 10,
              color: textColor,
              font: { size: 12, family: 'Inter' }
            }
          },
          tooltip: {
            backgroundColor: isDark ? '#1e293b' : '#0f172a',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            borderColor: isDark ? '#334155' : '#1e293b',
            borderWidth: 1,
            padding: 12,
            cornerRadius: 8,
            displayColors: true,
            boxPadding: 4
          }
        }
      }
    });
  }

  // 工作时长 - 柱状图 (使用Chart.js)
  const workCtx = document.getElementById('workChart');
  if (workCtx) {
    // 生成最近7天数据
    const days = [];
    const hours = [];
    for (let i = 6; i >= 0; i--) {
      const date = new Date();
      date.setDate(date.getDate() - i);
      const dateStr = date.toISOString().split('T')[0];
      days.push(`${date.getMonth() + 1}/${date.getDate()}`);
      const dayRecord = records.find(r => r.date === dateStr);
      hours.push(dayRecord ? dayRecord.duration : 0);
    }

    new Chart(workCtx.getContext('2d'), {
      type: 'bar',
      data: {
        labels: days,
        datasets: [{
          label: '工作时长 (小时)',
          data: hours,
          backgroundColor: isDark ? 'rgba(99, 102, 241, 0.6)' : 'rgba(99, 102, 241, 0.8)',
          borderRadius: 6,
          borderSkipped: false,
          barPercentage: 0.6,
          hoverBackgroundColor: isDark ? 'rgba(99, 102, 241, 0.8)' : 'rgba(99, 102, 241, 1)'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          },
          tooltip: {
            backgroundColor: isDark ? '#1e293b' : '#0f172a',
            titleColor: '#f1f5f9',
            bodyColor: '#cbd5e1',
            borderColor: isDark ? '#334155' : '#1e293b',
            borderWidth: 1,
            padding: 12,
            cornerRadius: 8,
            callbacks: {
              label: function(context) {
                return `${context.parsed.y} 小时`;
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: textColor,
              font: { size: 11, family: 'Inter' }
            },
            border: { display: false }
          },
          y: {
            beginAtZero: true,
            max: 12,
            grid: {
              color: gridColor,
              drawBorder: false
            },
            ticks: {
              color: textColor,
              font: { size: 11, family: 'Inter' },
              stepSize: 3,
              callback: function(value) {
                return value + 'h';
              }
            },
            border: { display: false }
          }
        }
      }
    });
  }
}

/**
 * 渲染ECharts图表
 */
function renderDashboardECharts(stats, records) {
  // 任务状态分布 - 使用ECharts
  const statusChartDom = document.getElementById('task-status-chart');
  if (statusChartDom && typeof echarts !== 'undefined') {
    const statusChart = echarts.init(statusChartDom);
    const statusOption = {
      tooltip: {
        trigger: 'item',
        formatter: '{a} <br/>{b}: {c} ({d}%)'
      },
      legend: {
        orient: 'vertical',
        right: 10,
        top: 'center',
        data: ['待开始', '进行中', '已提交', '审核中', '已通过', '已完成']
      },
      series: [
        {
          name: '任务状态',
          type: 'pie',
          radius: ['50%', '70%'],
          avoidLabelOverlap: false,
          itemStyle: {
            borderRadius: 10,
            borderColor: '#fff',
            borderWidth: 2
          },
          label: {
            show: false,
            position: 'center'
          },
          emphasis: {
            label: {
              show: true,
              fontSize: '14',
              fontWeight: 'bold'
            }
          },
          labelLine: {
            show: false
          },
          data: [
            { value: stats.pending || 0, name: '待开始', itemStyle: { color: '#94a3b8' } },
            { value: stats.in_progress || 0, name: '进行中', itemStyle: { color: '#3b82f6' } },
            { value: stats.submitted || 0, name: '已提交', itemStyle: { color: '#f59e0b' } },
            { value: stats.reviewing || 0, name: '审核中', itemStyle: { color: '#a855f7' } },
            { value: stats.approved || 0, name: '已通过', itemStyle: { color: '#22c55e' } },
            { value: stats.completed || 0, name: '已完成', itemStyle: { color: '#06b6d4' } }
          ]
        }
      ]
    };
    statusChart.setOption(statusOption);
    
    // 响应式
    window.addEventListener('resize', () => statusChart.resize());
  }
  
  // 工作时长趋势 - 使用ECharts
  const hoursChartDom = document.getElementById('work-hours-chart');
  if (hoursChartDom && typeof echarts !== 'undefined') {
    const hoursChart = echarts.init(hoursChartDom);
    
    // 生成最近14天数据
    const days = [];
    const hours = [];
    const cumulativeHours = [];
    let total = 0;
    
    for (let i = 13; i >= 0; i--) {
      const date = new Date();
      date.setDate(date.getDate() - i);
      const dateStr = date.toISOString().split('T')[0];
      days.push(`${date.getMonth() + 1}/${date.getDate()}`);
      const dayRecord = records.find(r => r.date === dateStr);
      const dayHours = dayRecord ? dayRecord.duration : 0;
      hours.push(dayHours);
      total += dayHours;
      cumulativeHours.push(total);
    }
    
    const hoursOption = {
      tooltip: {
        trigger: 'axis',
        axisPointer: {
          type: 'cross',
          label: {
            backgroundColor: '#6a7985'
          }
        }
      },
      legend: {
        data: ['每日时长', '累计时长']
      },
      grid: {
        left: '3%',
        right: '4%',
        bottom: '3%',
        containLabel: true
      },
      xAxis: [
        {
          type: 'category',
          boundaryGap: false,
          data: days
        }
      ],
      yAxis: [
        {
          type: 'value',
          name: '小时',
          axisLabel: {
            formatter: '{value}h'
          }
        }
      ],
      series: [
        {
          name: '每日时长',
          type: 'bar',
          data: hours,
          itemStyle: {
            color: '#3b82f6',
            borderRadius: [4, 4, 0, 0]
          }
        },
        {
          name: '累计时长',
          type: 'line',
          smooth: true,
          data: cumulativeHours,
          lineStyle: {
            color: '#10b981',
            width: 2
          },
          areaStyle: {
            color: {
              type: 'linear',
              x: 0,
              y: 0,
              x2: 0,
              y2: 1,
              colorStops: [
                { offset: 0, color: 'rgba(16, 185, 129, 0.3)' },
                { offset: 1, color: 'rgba(16, 185, 129, 0.05)' }
              ]
            }
          },
          itemStyle: {
            color: '#10b981'
          }
        }
      ]
    };
    hoursChart.setOption(hoursOption);
    
    // 响应式
    window.addEventListener('resize', () => hoursChart.resize());
  }
}

/**
 * 渲染排行榜
 */
function renderLeaderboard() {
  const users = dataManager.getUsers().filter(u => u.role === ROLES.STUDENT);
  const projects = dataManager.getProjects();
  const project = projects[0];
  
  // 计算每个学生的综合得分
  const leaderboardData = users.map(user => {
    const finalScore = project ? dataManager.calculateStudentScore(user.id, project.id) : 0;
    const tasks = dataManager.getTasks({ assigneeId: user.id });
    const completedTasks = tasks.filter(t => t.status === TASK_STATUS.COMPLETED || t.status === TASK_STATUS.APPROVED).length;
    return {
      ...user,
      score: finalScore || 0,
      completedTasks
    };
  }).sort((a, b) => b.score - a.score);
  
  if (leaderboardData.length === 0) {
    return '<p class="text-muted">暂无学生数据</p>';
  }
  
  return `
    <div class="leaderboard">
      ${leaderboardData.slice(0, 5).map((user, index) => `
        <div class="leaderboard-item">
          <div class="leaderboard-rank ${index === 0 ? 'gold' : index === 1 ? 'silver' : index === 2 ? 'bronze' : 'other'}">
            ${index + 1}
          </div>
          <div class="leaderboard-avatar">${user.name.charAt(0)}</div>
          <div class="leaderboard-info">
            <div class="leaderboard-name">${user.name}</div>
            <div class="leaderboard-detail">完成任务: ${user.completedTasks}</div>
          </div>
          <div class="leaderboard-score">${user.score}</div>
        </div>
      `).join('')}
    </div>
  `;
}

/**
 * 渲染日历视图
 */
function renderCalendarView() {
  const tasks = dataManager.getTasks();
  const today = new Date();
  const year = today.getFullYear();
  const month = today.getMonth();
  
  // 获取本月第一天和最后一天
  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0);
  
  // 获取本月第一天是星期几
  const startDayOfWeek = firstDay.getDay();
  
  // 生成日历数据
  const calendarDays = [];
  
  // 添加上个月的日期
  const prevMonthLastDay = new Date(year, month, 0).getDate();
  for (let i = startDayOfWeek - 1; i >= 0; i--) {
    calendarDays.push({
      date: new Date(year, month - 1, prevMonthLastDay - i),
      isCurrentMonth: false
    });
  }
  
  // 添加本月的日期
  for (let i = 1; i <= lastDay.getDate(); i++) {
    calendarDays.push({
      date: new Date(year, month, i),
      isCurrentMonth: true
    });
  }
  
  // 添加下个月的日期
  const remainingDays = 42 - calendarDays.length;
  for (let i = 1; i <= remainingDays; i++) {
    calendarDays.push({
      date: new Date(year, month + 1, i),
      isCurrentMonth: false
    });
  }
  
  // 获取任务截止日期
  const taskDeadlines = {};
  tasks.forEach(task => {
    if (task.dueDate) {
      const dateStr = task.dueDate;
      if (!taskDeadlines[dateStr]) {
        taskDeadlines[dateStr] = [];
      }
      taskDeadlines[dateStr].push(task);
    }
  });
  
  const weekDays = ['日', '一', '二', '三', '四', '五', '六'];
  const monthNames = ['一月', '二月', '三月', '四月', '五月', '六月', '七月', '八月', '九月', '十月', '十一月', '十二月'];
  
  return `
    <div class="calendar-container">
      <div class="calendar-header">
        <div class="calendar-title">${year}年 ${monthNames[month]}</div>
        <div class="calendar-nav">
          <button class="calendar-nav-btn" onclick="event.stopPropagation()">
            <i data-lucide="chevron-left" style="width:16px;height:16px"></i>
          </button>
          <button class="calendar-nav-btn" onclick="event.stopPropagation()">
            <i data-lucide="chevron-right" style="width:16px;height:16px"></i>
          </button>
        </div>
      </div>
      <div class="calendar-grid">
        ${weekDays.map(day => `
          <div class="calendar-day-header">${day}</div>
        `).join('')}
        ${calendarDays.slice(0, 35).map(day => {
          const dateStr = day.date.toISOString().split('T')[0];
          const isToday = dateStr === today.toISOString().split('T')[0];
          const dayTasks = taskDeadlines[dateStr] || [];
          
          return `
            <div class="calendar-day ${!day.isCurrentMonth ? 'other-month' : ''} ${isToday ? 'today' : ''}">
              <div class="calendar-day-number">${day.date.getDate()}</div>
              ${dayTasks.slice(0, 2).map(task => `
                <div class="calendar-event ${task.priority === 'high' ? 'deadline' : 'task'}">${task.title}</div>
              `).join('')}
              ${dayTasks.length > 2 ? `<div class="calendar-event task">+${dayTasks.length - 2}个任务</div>` : ''}
            </div>
          `;
        }).join('')}
      </div>
    </div>
  `;
}

function renderPendingTasks(user) {
  let tasks;
  if (user.role === ROLES.STUDENT) {
    tasks = dataManager.getTasks({ assigneeId: user.id });
  } else {
    tasks = dataManager.getTasks();
  }
  
  const pendingTasks = tasks.filter(t => 
    t.status === TASK_STATUS.PENDING || t.status === TASK_STATUS.IN_PROGRESS
  ).slice(0, 5);

  if (pendingTasks.length === 0) {
    return '<p class="text-muted">暂无待办任务</p>';
  }

  return `
    <table>
      <thead>
        <tr>
          <th>任务名称</th>
          <th>状态</th>
          <th>截止日期</th>
        </tr>
      </thead>
      <tbody>
        ${pendingTasks.map(task => `
          <tr>
            <td><a href="#" onclick="showTaskDetail('${task.id}')" style="font-weight:500;color:var(--text-primary);text-decoration:none;">${task.title}</a></td>
            <td>${getStatusBadge(task.status)}</td>
            <td>${formatDate(task.dueDate)}</td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

function renderRecentRecords(user) {
  const records = dataManager.getRecords({ userId: user.id }).slice(0, 5);

  if (records.length === 0) {
    return '<p class="text-muted">暂无工作记录</p>';
  }

  return `
    <div class="timeline">
      ${records.map(record => `
        <div class="timeline-item">
          <div class="timeline-date">${record.date}</div>
          <div class="timeline-content">
            <p>${record.content}</p>
            <div class="text-muted mt-1">工作时长：${record.duration}小时</div>
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderProjectProgress(project) {
  const phases = Object.entries(PHASE_CONFIG);
  const currentPhaseIndex = phases.findIndex(([key]) => key === project.phase);

  return `
    <div class="flow-chart">
      ${phases.map(([key, config], index) => `
        <div class="flow-step ${index <= currentPhaseIndex ? 'active' : ''}">
          <div class="step-number">${config.order}</div>
          <div class="step-name">${config.name}</div>
        </div>
        ${index < phases.length - 1 ? '<div class="flow-arrow">→</div>' : ''}
      `).join('')}
    </div>
  `;
}

// ==================== 任务管理页面 ====================

function renderTasks() {
  const currentUser = dataManager.getCurrentUser();
  const projects = dataManager.getProjects();
  const project = projects[0];

  let tasks;
  if (currentUser.role === ROLES.STUDENT) {
    tasks = dataManager.getTasks({ assigneeId: currentUser.id });
  } else if (project) {
    tasks = dataManager.getTasks({ projectId: project.id });
  } else {
    tasks = dataManager.getTasks();
  }

  // 统计数据
  const totalTasks = tasks.length;
  const completedTasks = tasks.filter(t => t.status === TASK_STATUS.COMPLETED || t.status === TASK_STATUS.APPROVED).length;
  const inProgressTasks = tasks.filter(t => t.status === TASK_STATUS.IN_PROGRESS).length;
  const pendingTasks = tasks.filter(t => t.status === TASK_STATUS.PENDING).length;
  const highPriorityTasks = tasks.filter(t => t.priority === 'high').length;
  const completionRate = totalTasks > 0 ? Math.round(completedTasks / totalTasks * 100) : 0;

  // 获取当前视图模式
  const viewMode = localStorage.getItem('taskViewMode') || 'list';

  return `
    <div class="page-header">
      <div class="page-header-left">
        <h1><i data-lucide="clipboard-list" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>任务管理</h1>
        <div class="subtitle">管理实训过程中的各项任务</div>
      </div>
      <div class="page-header-right">
        ${dataManager.hasPermission('task_create') ? `
          <button class="btn btn-primary" onclick="showCreateTaskModal()">
            <i data-lucide="plus" style="width:16px;height:16px;margin-right:4px"></i>新建任务
          </button>
        ` : ''}
      </div>
    </div>

    <!-- 统计卡片 -->
    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="clipboard-list"></i></div>
        <div class="info">
          <h3>${totalTasks}</h3>
          <p>任务总数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon green"><i data-lucide="check-circle"></i></div>
        <div class="info">
          <h3>${completionRate}%</h3>
          <p>完成率</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="clock"></i></div>
        <div class="info">
          <h3>${inProgressTasks}</h3>
          <p>进行中</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon purple"><i data-lucide="alert-triangle"></i></div>
        <div class="info">
          <h3>${highPriorityTasks}</h3>
          <p>高优先级</p>
        </div>
      </div>
    </div>

    <!-- 筛选和搜索 -->
    <div class="card mb-6">
      <div class="card-body">
        <div class="task-filters">
          <div class="search-box">
            <i data-lucide="search" class="search-icon"></i>
            <input type="text" placeholder="搜索任务..." class="form-control" id="task-search" oninput="filterTasks()">
          </div>
          <div class="filter-group">
            <select class="form-control" id="status-filter" onchange="filterTasks()">
              <option value="">所有状态</option>
              <option value="pending">待开始</option>
              <option value="in_progress">进行中</option>
              <option value="submitted">已提交</option>
              <option value="completed">已完成</option>
            </select>
            <select class="form-control" id="priority-filter" onchange="filterTasks()">
              <option value="">所有优先级</option>
              <option value="high">高优先级</option>
              <option value="medium">中优先级</option>
              <option value="low">低优先级</option>
            </select>
            <div class="view-toggle">
              <button class="btn btn-sm ${viewMode === 'list' ? 'btn-primary' : 'btn-outline'}" onclick="switchTaskView('list')">
                <i data-lucide="list" style="width:16px;height:16px"></i>
              </button>
              <button class="btn btn-sm ${viewMode === 'kanban' ? 'btn-primary' : 'btn-outline'}" onclick="switchTaskView('kanban')">
                <i data-lucide="layout-grid" style="width:16px;height:16px"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 批量操作栏 -->
    <div class="batch-actions" id="batch-actions" style="display:none;">
      <div class="batch-info">
        <span id="selected-count">0</span> 项已选择
      </div>
      <div class="batch-buttons">
        <button class="btn btn-sm btn-outline" onclick="batchUpdateStatus('in_progress')">
          <i data-lucide="play" style="width:14px;height:14px"></i> 批量开始
        </button>
        <button class="btn btn-sm btn-success" onclick="batchUpdateStatus('completed')">
          <i data-lucide="check" style="width:14px;height:14px"></i> 批量完成
        </button>
        <button class="btn btn-sm btn-danger" onclick="batchDeleteTasks()">
          <i data-lucide="trash-2" style="width:14px;height:14px"></i> 批量删除
        </button>
        <button class="btn btn-sm btn-ghost" onclick="clearSelection()">
          取消选择
        </button>
      </div>
    </div>

    <!-- 任务内容 -->
    ${viewMode === 'kanban' ? renderKanbanBoard(tasks) : renderTaskList(tasks)}
  `;
}

/**
 * 批量操作相关函数
 */
let selectedTasks = new Set();

function toggleTaskSelection(taskId) {
  if (selectedTasks.has(taskId)) {
    selectedTasks.delete(taskId);
  } else {
    selectedTasks.add(taskId);
  }
  updateBatchActions();
}

function selectAllTasks() {
  const checkboxes = document.querySelectorAll('.task-checkbox');
  checkboxes.forEach(cb => {
    cb.checked = true;
    selectedTasks.add(cb.dataset.taskId);
  });
  updateBatchActions();
}

function clearSelection() {
  selectedTasks.clear();
  const checkboxes = document.querySelectorAll('.task-checkbox');
  checkboxes.forEach(cb => cb.checked = false);
  updateBatchActions();
}

function updateBatchActions() {
  const batchBar = document.getElementById('batch-actions');
  const countEl = document.getElementById('selected-count');
  
  if (selectedTasks.size > 0) {
    batchBar.style.display = 'flex';
    countEl.textContent = selectedTasks.size;
  } else {
    batchBar.style.display = 'none';
  }
}

function batchUpdateStatus(status) {
  if (selectedTasks.size === 0) return;
  
  const confirmMsg = status === 'completed' ? '确定要批量完成选中的任务吗？' : '确定要批量开始选中的任务吗？';
  if (!confirm(confirmMsg)) return;
  
  selectedTasks.forEach(taskId => {
    dataManager.updateTaskStatus(taskId, status);
  });
  
  showToast(`已批量更新 ${selectedTasks.size} 个任务`, 'success');
  clearSelection();
  navigateTo('tasks');
}

function batchDeleteTasks() {
  if (selectedTasks.size === 0) return;
  
  if (!confirm(`确定要删除选中的 ${selectedTasks.size} 个任务吗？此操作不可撤销。`)) return;
  
  selectedTasks.forEach(taskId => {
    dataManager.deleteTask(taskId);
  });
  
  showToast(`已删除 ${selectedTasks.size} 个任务`, 'success');
  clearSelection();
  navigateTo('tasks');
}

/**
 * 切换任务视图
 */
function switchTaskView(mode) {
  localStorage.setItem('taskViewMode', mode);
  navigateTo('tasks');
}

/**
 * 渲染看板视图
 */
function renderKanbanBoard(tasks) {
  const statusColumns = [
    { key: TASK_STATUS.PENDING, name: '待开始', color: '#94a3b8' },
    { key: TASK_STATUS.IN_PROGRESS, name: '进行中', color: '#3b82f6' },
    { key: TASK_STATUS.SUBMITTED, name: '已提交', color: '#f59e0b' },
    { key: TASK_STATUS.REVIEWING, name: '审核中', color: '#a855f7' },
    { key: TASK_STATUS.APPROVED, name: '已通过', color: '#22c55e' },
    { key: TASK_STATUS.COMPLETED, name: '已完成', color: '#06b6d4' }
  ];

  return `
    <div class="kanban-board">
      ${statusColumns.map(column => {
        const columnTasks = tasks.filter(t => t.status === column.key);
        return `
          <div class="kanban-column">
            <div class="kanban-column-header">
              <div class="kanban-column-title">
                <span style="width:8px;height:8px;border-radius:50%;background:${column.color}"></span>
                ${column.name}
              </div>
              <span class="kanban-column-count">${columnTasks.length}</span>
            </div>
            <div class="kanban-column-body">
              ${columnTasks.map(task => `
                <div class="kanban-card" onclick="showTaskDetail('${task.id}')">
                  <div class="kanban-card-title">${task.title}</div>
                  <div class="kanban-card-meta">
                    <div class="kanban-card-assignee">
                      <div class="avatar-xs">${getUserName(task.assigneeId).charAt(0)}</div>
                      <span>${getUserName(task.assigneeId)}</span>
                    </div>
                    <span>${getPriorityBadge(task.priority)}</span>
                  </div>
                  ${task.dueDate ? `
                    <div class="kanban-card-meta mt-2">
                      <span class="${isOverdue(task.dueDate) ? 'text-danger' : ''}">
                        <i data-lucide="calendar" style="width:12px;height:12px;vertical-align:middle;margin-right:4px"></i>
                        ${formatDate(task.dueDate)}
                      </span>
                    </div>
                  ` : ''}
                </div>
              `).join('')}
              ${columnTasks.length === 0 ? `
                <div class="text-center text-muted" style="padding:20px;font-size:var(--text-sm)">
                  暂无任务
                </div>
              ` : ''}
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

/**
 * 渲染列表视图
 */
function renderTaskList(tasks) {
  return `
    <div class="card">
      <div class="card-header">
        <h3><i data-lucide="list" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>任务列表</h3>
        <div class="card-header-actions">
          <span class="badge badge-primary">${tasks.length} 个任务</span>
          <button class="btn btn-sm btn-ghost" onclick="selectAllTasks()" title="全选">
            <i data-lucide="check-square" style="width:14px;height:14px"></i>
          </button>
        </div>
      </div>
      <div class="card-body">
        <div class="table-container">
          <table class="task-table">
            <thead>
              <tr>
                <th style="width:40px">
                  <input type="checkbox" class="select-all-checkbox" onchange="toggleSelectAll(this)">
                </th>
                <th>任务名称</th>
                <th>负责人</th>
                <th>优先级</th>
                <th>状态</th>
                <th>截止日期</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              ${tasks.map(task => `
                <tr class="task-row" data-status="${task.status}" data-priority="${task.priority}" data-task-id="${task.id}">
                  <td>
                    <input type="checkbox" class="task-checkbox" data-task-id="${task.id}" onchange="toggleTaskSelection('${task.id}')">
                  </td>
                  <td>
                    <div class="task-title">
                      <a href="#" onclick="showTaskDetail('${task.id}')">${task.title}</a>
                      ${task.priority === 'high' ? '<span class="priority-dot high"></span>' : ''}
                    </div>
                  </td>
                  <td>
                    <div class="assignee">
                      <div class="avatar-sm">${getUserName(task.assigneeId).charAt(0)}</div>
                      <span>${getUserName(task.assigneeId)}</span>
                    </div>
                  </td>
                  <td>${getPriorityBadge(task.priority)}</td>
                  <td>${getStatusBadge(task.status)}</td>
                  <td>
                    <div class="due-date ${isOverdue(task.dueDate) ? 'overdue' : ''}">
                      <i data-lucide="calendar" style="width:14px;height:14px"></i>
                      <span>${formatDate(task.dueDate)}</span>
                    </div>
                  </td>
                  <td>
                    <div class="table-actions">
                      ${renderTaskActions(task)}
                    </div>
                  </td>
                </tr>
              `).join('')}
              ${tasks.length === 0 ? `
                <tr>
                  <td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted)">暂无任务数据</td>
                </tr>
              ` : ''}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  `;
}

/**
 * 全选/取消全选
 */
function toggleSelectAll(checkbox) {
  const checkboxes = document.querySelectorAll('.task-checkbox');
  checkboxes.forEach(cb => {
    cb.checked = checkbox.checked;
    const taskId = cb.dataset.taskId;
    if (checkbox.checked) {
      selectedTasks.add(taskId);
    } else {
      selectedTasks.delete(taskId);
    }
  });
  updateBatchActions();
}

// 检查是否逾期
function isOverdue(dueDate) {
  if (!dueDate) return false;
  return new Date(dueDate) < new Date();
}

// 筛选任务
function filterTasks() {
  const searchText = document.getElementById('task-search')?.value.toLowerCase() || '';
  const statusFilter = document.getElementById('status-filter')?.value || '';
  const priorityFilter = document.getElementById('priority-filter')?.value || '';
  
  const rows = document.querySelectorAll('.task-row');
  rows.forEach(row => {
    const title = row.querySelector('.task-title a')?.textContent.toLowerCase() || '';
    const status = row.dataset.status;
    const priority = row.dataset.priority;
    
    const matchSearch = !searchText || title.includes(searchText);
    const matchStatus = !statusFilter || status === statusFilter;
    const matchPriority = !priorityFilter || priority === priorityFilter;
    
    row.style.display = matchSearch && matchStatus && matchPriority ? '' : 'none';
  });
}

function renderTaskActions(task) {
  const currentUser = dataManager.getCurrentUser();
  let actions = [];

  if (currentUser.role === ROLES.STUDENT && task.assigneeId === currentUser.id) {
    if (task.status === TASK_STATUS.PENDING) {
      actions.push(`<button class="btn btn-sm btn-primary" onclick="updateTaskStatus('${task.id}', '${TASK_STATUS.IN_PROGRESS}')">开始</button>`);
    }
    if (task.status === TASK_STATUS.IN_PROGRESS) {
      actions.push(`<button class="btn btn-sm btn-success" onclick="updateTaskStatus('${task.id}', '${TASK_STATUS.SUBMITTED}')">提交</button>`);
    }
  }

  if (dataManager.hasPermission('task_assign')) {
    if (task.status === TASK_STATUS.SUBMITTED) {
      actions.push(`<button class="btn btn-sm btn-success" onclick="updateTaskStatus('${task.id}', '${TASK_STATUS.APPROVED}')">通过</button>`);
      actions.push(`<button class="btn btn-sm btn-danger" onclick="updateTaskStatus('${task.id}', '${TASK_STATUS.REJECTED}')">驳回</button>`);
    }
  }

  if (dataManager.hasPermission('task_create') && 
      (currentUser.role === ROLES.ADMIN || 
       (currentUser.role === ROLES.TEACHER && String(task.createdById) === String(currentUser.id)))) {
    actions.push(`<button class="btn btn-sm btn-danger" onclick="confirmDeleteTask('${task.id}')">删除</button>`);
  }

  actions.push(`<button class="btn btn-sm btn-outline" onclick="showTaskDetail('${task.id}')">详情</button>`);

  return `<div class="d-flex gap-1">${actions.join('')}</div>`;
}

function updateTaskStatus(taskId, status) {
  const comment = status === TASK_STATUS.REJECTED ? prompt('请输入驳回原因：') : '';
  if (status === TASK_STATUS.REJECTED && comment === null) return;

  dataManager.updateTaskStatus(taskId, status, comment);
  showToast('任务状态已更新', 'success');
  navigateTo('tasks');
}

function confirmDeleteTask(taskId) {
  const task = dataManager.getTaskById(taskId);
  if (!task) return;

  const content = `
    <div class="flex flex-col gap-4">
      <p>确定要删除以下任务吗？此操作不可撤销。</p>
      <div class="p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
        <p><strong>任务名称：</strong>${task.title}</p>
        <p><strong>负责人：</strong>${getUserName(task.assigneeId)}</p>
        <p><strong>状态：</strong>${getStatusBadge(task.status)}</p>
      </div>
      <div class="form-actions">
        <button class="btn btn-outline" onclick="closeModal()">取消</button>
        <button class="btn btn-danger" onclick="handleDeleteTask('${taskId}')">确认删除</button>
      </div>
    </div>
  `;

  showModal('删除确认', content);
}

function handleDeleteTask(taskId) {
  dataManager.deleteTask(taskId);
  closeModal();
  showToast('任务已删除', 'success');
  navigateTo('tasks');
}

function showTaskDetail(taskId) {
  const task = dataManager.getTaskById(taskId);
  if (!task) return;

  const currentUser = dataManager.getCurrentUser();
  const assignee = dataManager.getUserById(task.assigneeId);
  const assigner = dataManager.getUserById(task.assignerId);

  const content = `
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-xl font-bold">${task.title}</h3>
          <p class="text-muted">创建于 ${task.createdAt}</p>
        </div>
        <div class="flex gap-2">
          ${renderTaskActions(task)}
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="info" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>基本信息</h4>
        </div>
        <div class="card-body">
          <div class="grid grid-2 gap-4">
            <div><strong>所属阶段：</strong>${PHASE_CONFIG[task.phase]?.name || task.phase}</div>
            <div><strong>负责人：</strong>${assignee?.name || '-'}</div>
            <div><strong>分配人：</strong>${assigner?.name || '-'}</div>
            <div><strong>优先级：</strong>${getPriorityBadge(task.priority)}</div>
            <div><strong>状态：</strong>${getStatusBadge(task.status)}</div>
            <div><strong>开始日期：</strong>${formatDate(task.startDate)}</div>
            <div><strong>截止日期：</strong>${formatDate(task.dueDate)}</div>
            ${task.completedDate ? `<div><strong>完成日期：</strong>${formatDate(task.completedDate)}</div>` : ''}
          </div>
          <div class="mt-4">
            <strong>任务描述：</strong>
            <div class="mt-2 p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
              ${task.description}
            </div>
          </div>
        </div>
      </div>
      
      ${task.attachments && task.attachments.length > 0 ? `
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="paperclip" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>附件</h4>
        </div>
          <div class="card-body">
            <div class="attachment-list">
              ${task.attachments.map(att => `
                <div class="attachment-item flex items-center gap-2 p-2" style="border-bottom:1px solid var(--border-color);">
                  <i data-lucide="file" style="width:16px;height:16px"></i>
                  <span>${att}</span>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      ` : ''}
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="message-square" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>评论记录 (${task.comments.length})</h4>
        </div>
        <div class="card-body">
          ${task.comments.length > 0 ? `
            <div class="comment-list">
              ${task.comments.map(c => `
                <div class="comment-item p-3 mb-3" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
                  <div class="flex items-center gap-2 mb-2">
                    <div class="user-avatar-sm">${getUserName(c.userId).charAt(0)}</div>
                    <span class="font-semibold">${getUserName(c.userId)}</span>
                    <span class="text-muted text-sm">${c.createdAt}</span>
                  </div>
                  <p>${c.content}</p>
                </div>
              `).join('')}
            </div>
          ` : '<p class="text-muted">暂无评论</p>'}
          
          <div class="mt-4">
            <div class="form-group">
              <label>添加评论</label>
              <textarea class="form-control" id="task-comment-input" placeholder="请输入评论内容..." rows="3"></textarea>
            </div>
            <button class="btn btn-primary btn-sm" onclick="addTaskComment('${taskId}')">提交评论</button>
          </div>
        </div>
      </div>
    </div>
  `;

  showModal('任务详情', content);
}

/**
 * 添加任务评论
 */
function addTaskComment(taskId) {
  const commentInput = document.getElementById('task-comment-input');
  const content = commentInput.value.trim();
  
  if (!content) {
    showToast('请输入评论内容', 'warning');
    return;
  }
  
  dataManager.addTaskComment(taskId, content);
  showToast('评论已添加', 'success');
  showTaskDetail(taskId); // 刷新详情
}

function showCreateTaskModal() {
  const projects = dataManager.getProjects();
  const users = dataManager.getUsers().filter(u => u.role === ROLES.STUDENT);

  const content = `
    <form id="create-task-form" onsubmit="handleCreateTask(event)">
      <div class="form-group">
        <label>任务名称 *</label>
        <input type="text" class="form-control" name="title" required>
      </div>
      <div class="form-group">
        <label>任务描述 *</label>
        <textarea class="form-control" name="description" required></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>所属阶段 *</label>
          <select class="form-control" name="phase" required>
            ${Object.entries(PHASE_CONFIG).map(([key, config]) => `
              <option value="${key}">${config.name}</option>
            `).join('')}
          </select>
        </div>
        <div class="form-group">
          <label>负责人 *</label>
          <select class="form-control" name="assigneeId" required>
            ${users.map(user => `
              <option value="${user.id}">${user.name}</option>
            `).join('')}
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>优先级 *</label>
          <select class="form-control" name="priority" required>
            <option value="high">高</option>
            <option value="medium" selected>中</option>
            <option value="low">低</option>
          </select>
        </div>
        <div class="form-group">
          <label>截止日期 *</label>
          <input type="date" class="form-control" name="dueDate" required>
        </div>
      </div>
      <input type="hidden" name="projectId" value="${projects[0]?.id || ''}">
      <input type="hidden" name="assignerId" value="${dataManager.getCurrentUser().id}">
      <input type="hidden" name="startDate" value="${new Date().toISOString().split('T')[0]}">
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">创建任务</button>
      </div>
    </form>
  `;

  showModal('新建任务', content);
}

function handleCreateTask(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const taskData = Object.fromEntries(formData.entries());

  dataManager.createTask(taskData);
  closeModal();
  showToast('任务创建成功', 'success');
  navigateTo('tasks');
}

// ==================== 过程记录页面 ====================

function renderRecords() {
  const currentUser = dataManager.getCurrentUser();
  const records = dataManager.getRecords({ userId: currentUser.id });

  // 统计信息
  const totalDuration = records.reduce((sum, r) => sum + (r.duration || 0), 0);
  const thisWeekRecords = records.filter(r => {
    const recordDate = new Date(r.date);
    const today = new Date();
    const weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
    return recordDate >= weekAgo;
  });

  return `
    <div class="page-header">
      <h1><i data-lucide="file-text" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>过程记录</h1>
      <div class="subtitle">记录每日工作内容和学习心得</div>
    </div>

    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="file-text"></i></div>
        <div class="info">
          <h3>${records.length}</h3>
          <p>记录总数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon green"><i data-lucide="clock"></i></div>
        <div class="info">
          <h3>${totalDuration}h</h3>
          <p>总工作时长</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="calendar"></i></div>
        <div class="info">
          <h3>${thisWeekRecords.length}</h3>
          <p>本周记录</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon purple"><i data-lucide="bar-chart-3"></i></div>
        <div class="info">
          <h3>${records.length > 0 ? Math.round(totalDuration / records.length * 10) / 10 : 0}h</h3>
          <p>平均时长</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>工作记录</h3>
        <button class="btn btn-primary btn-sm" onclick="showCreateRecordModal()">+ 新建记录</button>
      </div>
      <div class="card-body">
        ${records.length > 0 ? `
          <div class="timeline">
            ${records.map(record => `
              <div class="timeline-item">
                <div class="timeline-date">${record.date}</div>
                <div class="timeline-content">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-semibold">${record.taskId ? '关联任务：' + (dataManager.getTaskById(record.taskId)?.title || '-') : '日常记录'}</span>
                    <div class="flex items-center gap-2">
                      <span class="text-muted">工作时长：${record.duration}小时</span>
                      <button class="btn btn-sm btn-outline" onclick="showRecordDetail('${record.id}')">详情</button>
                      <button class="btn btn-sm btn-primary" onclick="showEditRecordModal('${record.id}')">编辑</button>
                      <button class="btn btn-sm btn-danger" onclick="confirmDeleteRecord('${record.id}')">删除</button>
                    </div>
                  </div>
                  <p>${record.content}</p>
                  ${record.issues ? `<div class="mt-2 text-warning">遇到问题：${record.issues}</div>` : ''}
                  ${record.plan ? `<div class="mt-1 text-primary">明日计划：${record.plan}</div>` : ''}
                </div>
              </div>
            `).join('')}
          </div>
        ` : `
          <div class="empty-state">
            <i data-lucide="file-text" style="width:48px;height:48px;margin-bottom:16px;opacity:0.5"></i>
            <h3>暂无工作记录</h3>
            <p>点击上方按钮创建第一条记录</p>
          </div>
        `}
      </div>
    </div>
  `;
}

/**
 * 显示记录详情
 */
function showRecordDetail(recordId) {
  const record = dataManager.getRecordById(recordId);
  if (!record) {
    showToast('记录不存在', 'error');
    return;
  }

  const task = record.taskId ? dataManager.getTaskById(record.taskId) : null;

  const content = `
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-xl font-bold">${record.date} 工作记录</h3>
          <p class="text-muted">创建于 ${record.createdAt}</p>
        </div>
        <div class="flex gap-2">
          <button class="btn btn-sm btn-primary" onclick="closeModal(); showEditRecordModal('${recordId}')">编辑</button>
          <button class="btn btn-sm btn-danger" onclick="closeModal(); confirmDeleteRecord('${recordId}')">删除</button>
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="info" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>基本信息</h4>
        </div>
        <div class="card-body">
          <div class="grid grid-2 gap-4">
            <div><strong>日期：</strong>${record.date}</div>
            <div><strong>工作时长：</strong>${record.duration}小时</div>
            <div><strong>关联任务：</strong>${task ? task.title : '无'}</div>
            <div><strong>记录类型：</strong>${task ? '任务记录' : '日常记录'}</div>
          </div>
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="file-text" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>工作内容</h4>
        </div>
        <div class="card-body">
          <div class="p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
            ${record.content}
          </div>
        </div>
      </div>
      
      ${record.issues ? `
        <div class="card">
          <div class="card-header">
            <h4><i data-lucide="alert-triangle" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>遇到问题</h4>
          </div>
          <div class="card-body">
            <div class="p-4" style="background:var(--warning-50); border-radius:var(--radius-lg);">
              ${record.issues}
            </div>
          </div>
        </div>
      ` : ''}
      
      ${record.plan ? `
        <div class="card">
          <div class="card-header">
            <h4><i data-lucide="calendar" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>明日计划</h4>
          </div>
          <div class="card-body">
            <div class="p-4" style="background:var(--primary-50); border-radius:var(--radius-lg);">
              ${record.plan}
            </div>
          </div>
        </div>
      ` : ''}
    </div>
  `;

  showModal('记录详情', content);
}

/**
 * 显示编辑记录模态框
 */
function showEditRecordModal(recordId) {
  const record = dataManager.getRecordById(recordId);
  if (!record) {
    showToast('记录不存在', 'error');
    return;
  }

  const currentUser = dataManager.getCurrentUser();
  const tasks = dataManager.getTasks({ assigneeId: currentUser.id });

  const content = `
    <form id="edit-record-form" onsubmit="handleEditRecord(event, '${recordId}')">
      <div class="form-row">
        <div class="form-group">
          <label>日期 *</label>
          <input type="date" class="form-control" name="date" value="${record.date}" required>
        </div>
        <div class="form-group">
          <label>工作时长（小时）*</label>
          <input type="number" class="form-control" name="duration" min="0.5" max="24" step="0.5" value="${record.duration}" required>
        </div>
      </div>
      <div class="form-group">
        <label>关联任务</label>
        <select class="form-control" name="taskId">
          <option value="">-- 无关联任务 --</option>
          ${tasks.map(task => `
            <option value="${task.id}" ${record.taskId === task.id ? 'selected' : ''}>${task.title}</option>
          `).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>工作内容 *</label>
        <textarea class="form-control" name="content" required>${record.content}</textarea>
      </div>
      <div class="form-group">
        <label>遇到的问题</label>
        <textarea class="form-control" name="issues" placeholder="遇到了什么问题...">${record.issues || ''}</textarea>
      </div>
      <div class="form-group">
        <label>明日计划</label>
        <textarea class="form-control" name="plan" placeholder="明天计划做什么...">${record.plan || ''}</textarea>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">保存修改</button>
      </div>
    </form>
  `;

  showModal('编辑记录', content);
}

/**
 * 处理编辑记录
 */
function handleEditRecord(event, recordId) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const recordData = Object.fromEntries(formData.entries());
  recordData.duration = parseFloat(recordData.duration);

  dataManager.updateRecord(recordId, recordData);
  closeModal();
  showToast('记录已更新', 'success');
  navigateTo('records');
}

/**
 * 确认删除记录
 */
function confirmDeleteRecord(recordId) {
  const content = `
    <div class="text-center">
      <i data-lucide="alert-triangle" style="width:48px;height:48px;margin-bottom:16px;color:var(--amber-500)"></i>
      <h3 class="text-xl font-bold mb-2">确认删除记录</h3>
      <p class="text-muted mb-4">确定要删除这条工作记录吗？此操作不可撤销。</p>
    </div>
  `;
  
  showModal('删除确认', content);
  
  setTimeout(() => {
    const modalFooter = document.querySelector('.modal-footer');
    if (modalFooter) {
      modalFooter.innerHTML = `
        <button class="btn btn-outline" onclick="closeModal()">取消</button>
        <button class="btn btn-danger" onclick="handleDeleteRecord('${recordId}')">确认删除</button>
      `;
    }
  }, 50);
}

/**
 * 处理删除记录
 */
function handleDeleteRecord(recordId) {
  dataManager.deleteRecord(recordId);
  closeModal();
  showToast('记录已删除', 'success');
  navigateTo('records');
}

function showCreateRecordModal() {
  const currentUser = dataManager.getCurrentUser();
  const tasks = dataManager.getTasks({ assigneeId: currentUser.id });

  const content = `
    <form id="create-record-form" onsubmit="handleCreateRecord(event)">
      <div class="form-row">
        <div class="form-group">
          <label>日期 *</label>
          <input type="date" class="form-control" name="date" value="${new Date().toISOString().split('T')[0]}" required>
        </div>
        <div class="form-group">
          <label>工作时长（小时）*</label>
          <input type="number" class="form-control" name="duration" min="0.5" max="24" step="0.5" value="4" required>
        </div>
      </div>
      <div class="form-group">
        <label>关联任务</label>
        <select class="form-control" name="taskId">
          <option value="">-- 无关联任务 --</option>
          ${tasks.map(task => `
            <option value="${task.id}">${task.title}</option>
          `).join('')}
        </select>
      </div>
      <div class="form-group">
        <label>工作内容 *</label>
        <textarea class="form-control" name="content" placeholder="描述今天的工作内容..." required></textarea>
      </div>
      <div class="form-group">
        <label>遇到的问题</label>
        <textarea class="form-control" name="issues" placeholder="描述遇到的问题或困难..."></textarea>
      </div>
      <div class="form-group">
        <label>明日计划</label>
        <textarea class="form-control" name="plan" placeholder="明天计划做什么..."></textarea>
      </div>
      <input type="hidden" name="type" value="daily">
      <input type="hidden" name="projectId" value="${dataManager.getProjects()[0]?.id || ''}">
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">保存记录</button>
      </div>
    </form>
  `;

  showModal('新建工作记录', content);
}

function handleCreateRecord(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const recordData = Object.fromEntries(formData.entries());
  recordData.duration = parseFloat(recordData.duration);

  dataManager.createRecord(recordData);
  closeModal();
  showToast('工作记录已保存', 'success');
  navigateTo('records');
}

// ==================== 评价系统页面 ====================

function renderEvaluate() {
  const currentUser = dataManager.getCurrentUser();
  const projects = dataManager.getProjects();
  const project = projects[0];

  let evaluations = [];
  if (currentUser.role === ROLES.STUDENT) {
    evaluations = dataManager.getEvaluations({ evaluateeId: currentUser.id, projectId: project?.id });
  } else {
    evaluations = dataManager.getEvaluations({ projectId: project?.id });
  }

  return `
    <div class="page-header">
      <h1><i data-lucide="star" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>评价系统</h1>
      <div class="subtitle">多维度评价与反馈</div>
    </div>

    ${currentUser.role === ROLES.STUDENT ? renderStudentEvaluate(evaluations, project) : renderTeacherEvaluate(project)}
  `;
}

function renderStudentEvaluate(evaluations, project) {
  const currentUser = dataManager.getCurrentUser();
  const finalScore = project ? dataManager.calculateStudentScore(currentUser.id, project.id) : null;

  // 计算各维度平均分
  const dimensionAverages = {};
  if (evaluations.length > 0) {
    Object.keys(EVALUATE_DIMENSION_CONFIG).forEach(dim => {
      const scores = evaluations.map(e => e.dimensions[dim]).filter(s => s !== undefined);
      dimensionAverages[dim] = scores.length > 0 ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : 0;
    });
  }

  // 延迟渲染雷达图
  setTimeout(() => {
    renderRadarChart(dimensionAverages);
    renderEvaluationTrend(evaluations);
  }, 100);

  return `
    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon purple"><i data-lucide="star"></i></div>
        <div class="info">
          <h3>${finalScore || '-'}</h3>
          <p>综合得分</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon green"><i data-lucide="bar-chart-3"></i></div>
        <div class="info">
          <h3>${evaluations.length}</h3>
          <p>评价次数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="trophy"></i></div>
        <div class="info">
          <h3>${evaluations.length > 0 ? Math.max(...evaluations.map(e => e.totalScore)) : '-'}</h3>
          <p>最高得分</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="trending-up"></i></div>
        <div class="info">
          <h3>${evaluations.length > 0 ? Math.min(...evaluations.map(e => e.totalScore)) : '-'}</h3>
          <p>最低得分</p>
        </div>
      </div>
    </div>

    <div class="grid grid-2 gap-6 mb-6">
      ${evaluations.length > 0 ? `
        <div class="card">
          <div class="card-header">
            <h3><i data-lucide="bar-chart-3" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>维度分析</h3>
          </div>
          <div class="card-body">
            <div class="dimension-scores">
              ${Object.entries(EVALUATE_DIMENSION_CONFIG).map(([key, config]) => `
                <div class="dimension-item">
                  <div class="dimension-header">
                    <span class="dimension-name">${config.name}</span>
                    <span class="dimension-avg">平均：${dimensionAverages[key] || 0}</span>
                  </div>
                  <div class="dimension-desc">${config.description}</div>
                  <div class="dimension-bar">
                    <div class="dimension-bar-fill ${getScoreColorClass(dimensionAverages[key])}" style="width:${dimensionAverages[key] || 0}%"></div>
                  </div>
                  <div class="dimension-score">${dimensionAverages[key] || 0}</div>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
        
        <div class="card">
          <div class="card-header">
            <h3><i data-lucide="pie-chart" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>能力雷达图</h3>
          </div>
          <div class="card-body">
            <div class="radar-chart-container" id="radar-chart"></div>
          </div>
        </div>
      ` : ''}
    </div>

    ${evaluations.length > 0 ? `
      <div class="card mb-6">
        <div class="card-header">
          <h3><i data-lucide="trending-up" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>评价趋势</h3>
        </div>
        <div class="card-body">
          <div class="chart-container" id="evaluation-trend-chart"></div>
        </div>
      </div>
    ` : ''}

    <div class="card">
      <div class="card-header">
        <h3>评价记录</h3>
      </div>
      <div class="card-body">
        ${evaluations.length > 0 ? evaluations.map(evaluation => `
          <div class="card mb-4">
            <div class="card-body">
              <div class="flex items-center justify-between mb-3">
                <div>
                  <span class="font-semibold">评价人：${getUserName(evaluation.evaluatorId)}</span>
                  <span class="text-muted" style="margin-left:12px;">
                    ${evaluation.type === 'teacher' ? '教师评价' : evaluation.type === 'enterprise' ? '企业评价' : '同伴互评'}
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="badge badge-approved">得分：${evaluation.totalScore}</span>
                  <button class="btn btn-sm btn-outline" onclick="showEvaluationDetail('${evaluation.id}')">详情</button>
                </div>
              </div>
              <div class="dimension-scores">
                ${Object.entries(evaluation.dimensions).map(([dimension, score]) => {
                  const config = EVALUATE_DIMENSION_CONFIG[dimension];
                  return config ? `
                    <div class="dimension-item">
                      <div class="dimension-label">${config.name}</div>
                      <div class="dimension-bar">
                        <div class="dimension-bar-fill ${getScoreColorClass(score)}" style="width:${score}%"></div>
                      </div>
                      <div class="dimension-score">${score}</div>
                    </div>
                  ` : '';
                }).join('')}
              </div>
              ${evaluation.comment ? `
                <div class="mt-3 p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
                  <strong>评价意见：</strong>${evaluation.comment}
                </div>
              ` : ''}
              <div class="text-muted mt-2" style="font-size:0.75rem;">评价时间：${evaluation.createdAt}</div>
            </div>
          </div>
        `).join('') : `
          <div class="text-center text-muted" style="padding:40px;">
            <p>暂无评价记录</p>
          </div>
        `}
      </div>
    </div>
  `;
}

/**
 * 渲染雷达图
 */
function renderRadarChart(dimensionAverages) {
  const radarDom = document.getElementById('radar-chart');
  if (!radarDom || typeof echarts === 'undefined') return;
  
  const radarChart = echarts.init(radarDom);
  
  const indicator = Object.entries(EVALUATE_DIMENSION_CONFIG).map(([key, config]) => ({
    name: config.name,
    max: 100
  }));
  
  const values = Object.values(dimensionAverages);
  
  const option = {
    tooltip: {
      trigger: 'item'
    },
    radar: {
      indicator: indicator,
      shape: 'polygon',
      splitNumber: 5,
      axisName: {
        color: '#64748b',
        fontSize: 12
      },
      splitLine: {
        lineStyle: {
          color: '#e2e8f0'
        }
      },
      splitArea: {
        show: true,
        areaStyle: {
          color: ['rgba(59, 130, 246, 0.05)', 'rgba(59, 130, 246, 0.1)']
        }
      },
      axisLine: {
        lineStyle: {
          color: '#e2e8f0'
        }
      }
    },
    series: [
      {
        type: 'radar',
        data: [
          {
            value: values,
            name: '能力评分',
            symbol: 'circle',
            symbolSize: 6,
            lineStyle: {
              color: '#3b82f6',
              width: 2
            },
            areaStyle: {
              color: {
                type: 'linear',
                x: 0,
                y: 0,
                x2: 0,
                y2: 1,
                colorStops: [
                  { offset: 0, color: 'rgba(59, 130, 246, 0.3)' },
                  { offset: 1, color: 'rgba(59, 130, 246, 0.1)' }
                ]
              }
            },
            itemStyle: {
              color: '#3b82f6'
            }
          }
        ]
      }
    ]
  };
  
  radarChart.setOption(option);
  window.addEventListener('resize', () => radarChart.resize());
}

/**
 * 渲染评价趋势图
 */
function renderEvaluationTrend(evaluations) {
  const trendDom = document.getElementById('evaluation-trend-chart');
  if (!trendDom || typeof echarts === 'undefined' || evaluations.length === 0) return;
  
  const trendChart = echarts.init(trendDom);
  
  // 按时间排序
  const sortedEvals = [...evaluations].sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
  
  const dates = sortedEvals.map(e => e.createdAt.split(' ')[0]);
  const scores = sortedEvals.map(e => e.totalScore);
  
  const option = {
    tooltip: {
      trigger: 'axis',
      axisPointer: {
        type: 'shadow'
      }
    },
    grid: {
      left: '3%',
      right: '4%',
      bottom: '3%',
      containLabel: true
    },
    xAxis: {
      type: 'category',
      data: dates,
      axisLabel: {
        rotate: 45,
        fontSize: 11
      }
    },
    yAxis: {
      type: 'value',
      name: '分数',
      min: 60,
      max: 100,
      axisLabel: {
        formatter: '{value}'
      }
    },
    series: [
      {
        name: '综合得分',
        type: 'line',
        smooth: true,
        data: scores,
        lineStyle: {
          color: '#3b82f6',
          width: 3
        },
        areaStyle: {
          color: {
            type: 'linear',
            x: 0,
            y: 0,
            x2: 0,
            y2: 1,
            colorStops: [
              { offset: 0, color: 'rgba(59, 130, 246, 0.3)' },
              { offset: 1, color: 'rgba(59, 130, 246, 0.05)' }
            ]
          }
        },
        itemStyle: {
          color: '#3b82f6',
          borderWidth: 2,
          borderColor: '#fff'
        },
        markPoint: {
          data: [
            { type: 'max', name: '最高分' },
            { type: 'min', name: '最低分' }
          ]
        },
        markLine: {
          data: [{ type: 'average', name: '平均分' }]
        }
      }
    ]
  };
  
  trendChart.setOption(option);
  window.addEventListener('resize', () => trendChart.resize());
}

/**
 * 获取分数颜色类
 */
function getScoreColorClass(score) {
  if (score >= 90) return 'green';
  if (score >= 80) return 'blue';
  if (score >= 60) return 'orange';
  return 'red';
}

/**
 * 显示评价详情
 */
function showEvaluationDetail(evaluationId) {
  const evaluation = dataManager.getEvaluationById(evaluationId);
  if (!evaluation) {
    showToast('评价不存在', 'error');
    return;
  }

  const evaluator = dataManager.getUserById(evaluation.evaluatorId);
  const evaluatee = dataManager.getUserById(evaluation.evaluateeId);
  const task = evaluation.taskId ? dataManager.getTaskById(evaluation.taskId) : null;

  const content = `
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-xl font-bold">评价详情</h3>
          <p class="text-muted">${evaluation.createdAt}</p>
        </div>
        <span class="badge badge-${evaluation.type}">${
          evaluation.type === 'teacher' ? '教师评价' : 
          evaluation.type === 'enterprise' ? '企业评价' : '同伴互评'
        }</span>
      </div>
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="info" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>基本信息</h4>
        </div>
        <div class="card-body">
          <div class="grid grid-2 gap-4">
            <div><strong>评价人：</strong>${evaluator?.name || '-'}</div>
            <div><strong>被评价人：</strong>${evaluatee?.name || '-'}</div>
            <div><strong>评价类型：</strong>${
              evaluation.type === 'teacher' ? '教师评价' : 
              evaluation.type === 'enterprise' ? '企业评价' : '同伴互评'
            }</div>
            <div><strong>关联任务：</strong>${task ? task.title : '无'}</div>
            <div><strong>综合得分：</strong><span class="text-xl font-bold text-primary">${evaluation.totalScore}</span></div>
            <div><strong>评价时间：</strong>${evaluation.createdAt}</div>
          </div>
        </div>
      </div>
      
      <div class="card">
        <div class="card-header">
          <h4><i data-lucide="bar-chart-3" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>维度评分</h4>
        </div>
        <div class="card-body">
          <div class="dimension-scores">
            ${Object.entries(evaluation.dimensions).map(([dimension, score]) => {
              const config = EVALUATE_DIMENSION_CONFIG[dimension];
              return config ? `
                <div class="dimension-item">
                  <div class="dimension-header">
                    <span class="dimension-name">${config.name}</span>
                    <span>权重：${(config.weight * 100)}%</span>
                  </div>
                  <div class="dimension-desc">${config.description}</div>
                  <div class="dimension-bar">
                    <div class="dimension-bar-fill ${getScoreColorClass(score)}" style="width:${score}%"></div>
                  </div>
                  <div class="dimension-score">${score}</div>
                </div>
              ` : '';
            }).join('')}
          </div>
        </div>
      </div>
      
      ${evaluation.comment ? `
        <div class="card">
          <div class="card-header">
            <h4><i data-lucide="message-square" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>评价意见</h4>
          </div>
          <div class="card-body">
            <div class="p-4" style="background:var(--bg-tertiary); border-radius:var(--radius-lg);">
              ${evaluation.comment}
            </div>
          </div>
        </div>
      ` : ''}
    </div>
  `;

  showModal('评价详情', content);
}

function renderTeacherEvaluate(project) {
  const users = dataManager.getUsers().filter(u => u.role === ROLES.STUDENT);

  return `
    <div class="card">
      <div class="card-header">
        <h3>学生评价</h3>
        <button class="btn btn-primary btn-sm" onclick="showCreateEvaluationModal()">+ 新建评价</button>
      </div>
      <div class="card-body">
        <table>
          <thead>
            <tr>
              <th>学生姓名</th>
              <th>综合得分</th>
              <th>评价次数</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            ${users.map(user => {
              const finalScore = project ? dataManager.calculateStudentScore(user.id, project.id) : null;
              const evaluations = dataManager.getEvaluations({ evaluateeId: user.id, projectId: project?.id });
              return `
                <tr>
                  <td>${user.name}</td>
                  <td>${finalScore || '-'}</td>
                  <td>${evaluations.length}</td>
                  <td>
                    <button class="btn btn-sm btn-outline" onclick="showStudentEvaluationDetail('${user.id}')">查看详情</button>
                  </td>
                </tr>
              `;
            }).join('')}
          </tbody>
        </table>
      </div>
    </div>
  `;
}

function showStudentEvaluationDetail(studentId) {
  const evaluations = dataManager.getEvaluations({ evaluateeId: studentId });
  const student = dataManager.getUserById(studentId);

  const content = `
    <div>
      <h4 class="mb-4 font-semibold">${student.name} 的评价记录</h4>
      ${evaluations.map(evaluation => `
        <div class="card mb-3">
          <div class="card-body">
            <div class="flex items-center justify-between mb-3">
              <span>评价人：${getUserName(evaluation.evaluatorId)}</span>
              <span class="badge badge-approved">得分：${evaluation.totalScore}</span>
            </div>
            <div class="dimension-scores">
              ${Object.entries(evaluation.dimensions).map(([dim, score]) => {
                const config = EVALUATE_DIMENSION_CONFIG[dim];
                return config ? `
                  <div class="dimension-item">
                    <div class="dimension-label">${config.name}</div>
                    <div class="dimension-bar">
                      <div class="dimension-bar-fill blue" style="width:${score}%"></div>
                    </div>
                    <div class="dimension-score">${score}</div>
                  </div>
                ` : '';
              }).join('')}
            </div>
            ${evaluation.comment ? `<div class="mt-3">${evaluation.comment}</div>` : ''}
          </div>
        </div>
      `).join('')}
    </div>
  `;

  showModal('评价详情', content);
}

function showCreateEvaluationModal() {
  const users = dataManager.getUsers().filter(u => u.role === ROLES.STUDENT);
  const tasks = dataManager.getTasks();

  const content = `
    <form id="create-evaluation-form" onsubmit="handleCreateEvaluation(event)">
      <div class="form-row">
        <div class="form-group">
          <label>被评价学生 *</label>
          <select class="form-control" name="evaluateeId" required>
            ${users.map(user => `
              <option value="${user.id}">${user.name}</option>
            `).join('')}
          </select>
        </div>
        <div class="form-group">
          <label>评价类型 *</label>
          <select class="form-control" name="type" required>
            <option value="teacher">教师评价</option>
            <option value="enterprise">企业评价</option>
            <option value="peer">同伴互评</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label>关联任务</label>
        <select class="form-control" name="taskId">
          <option value="">-- 无关联任务 --</option>
          ${tasks.map(task => `
            <option value="${task.id}">${task.title}</option>
          `).join('')}
        </select>
      </div>
      
      <div class="form-group">
        <label>评分 *</label>
        <div class="dimension-scores">
          ${Object.entries(EVALUATE_DIMENSION_CONFIG).map(([key, config]) => `
            <div class="dimension-item">
              <div class="dimension-header">
                <span class="dimension-name">${config.name}</span>
                <span>权重：${(config.weight * 100)}%</span>
              </div>
              <div class="dimension-desc">${config.description}</div>
              <input type="range" name="dimension_${key}" min="0" max="100" value="80" 
                     oninput="this.nextElementSibling.textContent = this.value"
                     style="width:100%;">
              <span style="font-weight:500;">80</span>
            </div>
          `).join('')}
        </div>
      </div>

      <div class="form-group">
        <label>评价意见</label>
        <textarea class="form-control" name="comment" placeholder="请输入评价意见..."></textarea>
      </div>

      <input type="hidden" name="projectId" value="${dataManager.getProjects()[0]?.id || ''}">

      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">提交评价</button>
      </div>
    </form>
  `;

  showModal('新建评价', content);
}

function handleCreateEvaluation(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  
  const dimensions = {};
  for (const [key, config] of Object.entries(EVALUATE_DIMENSION_CONFIG)) {
    dimensions[key] = parseInt(formData.get(`dimension_${key}`) || 80);
  }

  const evaluationData = {
    evaluateeId: formData.get('evaluateeId'),
    type: formData.get('type'),
    taskId: formData.get('taskId') || null,
    projectId: formData.get('projectId'),
    dimensions: dimensions,
    comment: formData.get('comment')
  };

  dataManager.createEvaluation(evaluationData);
  closeModal();
  showToast('评价已提交', 'success');
  navigateTo('evaluate');
}

// ==================== 流程管理页面 ====================

function renderFlow() {
  const projects = dataManager.getProjects();
  const project = projects[0];
  const currentUser = dataManager.getCurrentUser();
  
  // 获取每个阶段的任务统计
  const phaseStats = {};
  Object.keys(PHASE_CONFIG).forEach(phase => {
    const tasks = dataManager.getTasks({ phase });
    const completed = tasks.filter(t => t.status === TASK_STATUS.COMPLETED || t.status === TASK_STATUS.APPROVED).length;
    phaseStats[phase] = {
      total: tasks.length,
      completed: completed,
      progress: tasks.length > 0 ? Math.round(completed / tasks.length * 100) : 0
    };
  });

  return `
    <div class="page-header">
      <h1><i data-lucide="git-branch" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>流程管理</h1>
      <div class="subtitle">实训全流程阶段管理</div>
    </div>

    <div class="card mb-6">
      <div class="card-header">
        <h3>实训流程模型</h3>
        ${currentUser.role === ROLES.ADMIN || currentUser.role === ROLES.TEACHER ? `
          <button class="btn btn-primary btn-sm" onclick="showAdvancePhaseModal()">推进阶段</button>
        ` : ''}
      </div>
      <div class="card-body">
        <div class="flow-chart">
          ${Object.entries(PHASE_CONFIG).map(([key, config], index) => `
            <div class="flow-step ${project && key === project.phase ? 'active' : ''} ${phaseStats[key].progress === 100 ? 'completed' : ''}">
              <div class="step-number">${config.order}</div>
              <div class="step-name">${config.name}</div>
              <div class="step-progress">${phaseStats[key].progress}%</div>
            </div>
            ${index < Object.keys(PHASE_CONFIG).length - 1 ? '<div class="flow-arrow">→</div>' : ''}
          `).join('')}
        </div>
      </div>
    </div>

    <div class="evaluate-grid">
      ${Object.entries(PHASE_CONFIG).map(([key, config]) => `
        <div class="card">
          <div class="card-header">
            <h3>${config.order}. ${config.name}</h3>
            <div class="flex items-center gap-2">
              ${project && key === project.phase ? '<span class="badge badge-in_progress">当前阶段</span>' : ''}
              <span class="badge badge-${phaseStats[key].progress === 100 ? 'completed' : 'pending'}">
                ${phaseStats[key].completed}/${phaseStats[key].total} 完成
              </span>
            </div>
          </div>
          <div class="card-body">
            <p class="mb-3">${config.description}</p>
            
            <div class="mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="font-semibold">阶段进度</span>
                <span>${phaseStats[key].progress}%</span>
              </div>
              <div class="dimension-bar">
                <div class="dimension-bar-fill ${phaseStats[key].progress === 100 ? 'green' : 'blue'}" style="width:${phaseStats[key].progress}%"></div>
              </div>
            </div>
            
            <h4 class="font-semibold mb-2">阶段任务：</h4>
            <ul style="list-style:none; padding:0;">
              ${config.tasks.map(task => `
                <li class="flex items-center gap-2" style="padding:8px 0; border-bottom:1px solid var(--border-color);">
                  <span class="text-primary">•</span>
                  <span>${task}</span>
                </li>
              `).join('')}
            </ul>
            
            ${currentUser.role === ROLES.ADMIN || currentUser.role === ROLES.TEACHER ? `
              <div class="mt-4">
                <button class="btn btn-outline btn-sm" onclick="showPhaseTaskModal('${key}')">查看阶段任务</button>
              </div>
            ` : ''}
          </div>
        </div>
      `).join('')}
    </div>
  `;
}

/**
 * 显示推进阶段模态框
 */
function showAdvancePhaseModal() {
  const projects = dataManager.getProjects();
  const project = projects[0];
  if (!project) {
    showToast('没有项目', 'error');
    return;
  }

  const phases = Object.entries(PHASE_CONFIG);
  const currentIndex = phases.findIndex(([key]) => key === project.phase);
  const nextPhase = phases[currentIndex + 1];

  if (!nextPhase) {
    showToast('已经是最后阶段', 'warning');
    return;
  }

  const content = `
    <div class="text-center">
      <i data-lucide="git-branch" style="width:48px;height:48px;margin-bottom:16px;color:var(--blue-500)"></i>
      <h3 class="text-xl font-bold mb-2">推进到下一阶段</h3>
      <p class="text-muted mb-4">
        当前阶段：<strong>${PHASE_CONFIG[project.phase].name}</strong><br>
        下一阶段：<strong>${nextPhase[1].name}</strong>
      </p>
      <p class="text-warning">确认要推进到下一阶段吗？此操作不可撤销。</p>
    </div>
  `;

  showModal('推进阶段', content);
  
  setTimeout(() => {
    const modalFooter = document.querySelector('.modal-footer');
    if (modalFooter) {
      modalFooter.innerHTML = `
        <button class="btn btn-outline" onclick="closeModal()">取消</button>
        <button class="btn btn-primary" onclick="handleAdvancePhase('${nextPhase[0]}')">确认推进</button>
      `;
    }
  }, 50);
}

/**
 * 处理推进阶段
 */
function handleAdvancePhase(newPhase) {
  dataManager.advanceProjectPhase(newPhase);
  closeModal();
  showToast('阶段已推进', 'success');
  navigateTo('flow');
}

/**
 * 显示阶段任务模态框
 */
function showPhaseTaskModal(phase) {
  const tasks = dataManager.getTasks({ phase });
  const phaseConfig = PHASE_CONFIG[phase];

  const content = `
    <div class="flex flex-col gap-4">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-xl font-bold">${phaseConfig.name} - 任务列表</h3>
          <p class="text-muted">${phaseConfig.description}</p>
        </div>
      </div>
      
      ${tasks.length > 0 ? `
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>任务名称</th>
                <th>负责人</th>
                <th>状态</th>
                <th>截止日期</th>
              </tr>
            </thead>
            <tbody>
              ${tasks.map(task => `
                <tr>
                  <td>${task.title}</td>
                  <td>${getUserName(task.assigneeId)}</td>
                  <td>${getStatusBadge(task.status)}</td>
                  <td>${formatDate(task.dueDate)}</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      ` : `
        <div class="text-center text-muted" style="padding:40px;">
          <p>该阶段暂无任务</p>
        </div>
      `}
    </div>
  `;

  showModal(`${phaseConfig.name} - 任务列表`, content);
}

// ==================== 用户管理页面 ====================

function renderUsers() {
  const users = dataManager.getUsers();
  const currentUser = dataManager.getCurrentUser();

  return `
    <div class="page-header">
      <h1><i data-lucide="users" style="width:24px;height:24px;vertical-align:middle;margin-right:8px"></i>用户管理</h1>
      <div class="subtitle">管理系统用户和权限</div>
    </div>

    <div class="dashboard-grid">
      <div class="stat-card">
        <div class="icon blue"><i data-lucide="users"></i></div>
        <div class="info">
          <h3>${users.length}</h3>
          <p>用户总数</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon green"><i data-lucide="graduation-cap"></i></div>
        <div class="info">
          <h3>${users.filter(u => u.role === ROLES.TEACHER).length}</h3>
          <p>指导教师</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon orange"><i data-lucide="book-open"></i></div>
        <div class="info">
          <h3>${users.filter(u => u.role === ROLES.STUDENT).length}</h3>
          <p>学生</p>
        </div>
      </div>
      <div class="stat-card">
        <div class="icon purple"><i data-lucide="building"></i></div>
        <div class="info">
          <h3>${users.filter(u => u.role === ROLES.ENTERPRISE).length}</h3>
          <p>企业导师</p>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3>用户列表</h3>
        <button class="btn btn-primary btn-sm" onclick="showCreateUserModal()">+ 添加用户</button>
      </div>
      <div class="card-body">
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>姓名</th>
                <th>用户名</th>
                <th>角色</th>
                <th>部门</th>
                <th>邮箱</th>
                <th>电话</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody>
              ${users.map(user => `
                <tr>
                  <td>
                    <div class="flex items-center gap-2">
                      <div class="user-avatar-sm">${user.name.charAt(0)}</div>
                      <span class="font-semibold">${user.name}</span>
                    </div>
                  </td>
                  <td>${user.username}</td>
                  <td><span class="badge badge-${user.role}">${ROLE_PERMISSIONS[user.role]?.name || user.role}</span></td>
                  <td>${user.department || '-'}</td>
                  <td>${user.email || '-'}</td>
                  <td>${user.phone || '-'}</td>
                  <td>
                    <div class="flex gap-2">
                      <button class="btn btn-sm btn-outline" onclick="showUserDetail('${user.id}')">详情</button>
                      <button class="btn btn-sm btn-primary" onclick="showEditUserModal('${user.id}')">编辑</button>
                      ${user.id !== currentUser.id ? `
                        <button class="btn btn-sm btn-danger" onclick="confirmDeleteUser('${user.id}')">删除</button>
                      ` : ''}
                    </div>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  `;
}

/**
 * 显示用户详情
 */
function showUserDetail(userId) {
  const user = dataManager.getUserById(userId);
  if (!user) {
    showToast('用户不存在', 'error');
    return;
  }

  const tasks = dataManager.getTasks({ assigneeId: userId });
  const records = dataManager.getRecords({ userId });
  const evaluations = dataManager.getEvaluations({ evaluateeId: userId });

  const content = `
    <div class="flex flex-col gap-4">
      <div class="flex items-center gap-4 mb-4">
        <div class="user-avatar-lg">${user.name.charAt(0)}</div>
        <div>
          <h3 class="text-xl font-bold">${user.name}</h3>
          <p class="text-muted">${ROLE_PERMISSIONS[user.role]?.name || user.role}</p>
        </div>
      </div>
      
      <div class="grid grid-2 gap-4">
        <div><strong>用户名：</strong>${user.username}</div>
        <div><strong>邮箱：</strong>${user.email || '-'}</div>
        <div><strong>电话：</strong>${user.phone || '-'}</div>
        <div><strong>部门：</strong>${user.department || '-'}</div>
        ${user.studentId ? `<div><strong>学号：</strong>${user.studentId}</div>` : ''}
        ${user.company ? `<div><strong>公司：</strong>${user.company}</div>` : ''}
      </div>
      
      <div class="card mt-4">
        <div class="card-header">
          <h4><i data-lucide="bar-chart-2" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>用户统计</h4>
        </div>
        <div class="card-body">
          <div class="grid grid-3 gap-4">
            <div class="text-center">
              <div class="text-2xl font-bold text-primary">${tasks.length}</div>
              <div class="text-muted">分配任务</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-success">${records.length}</div>
              <div class="text-muted">工作记录</div>
            </div>
            <div class="text-center">
              <div class="text-2xl font-bold text-warning">${evaluations.length}</div>
              <div class="text-muted">收到评价</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  `;

  showModal('用户详情', content);
}

/**
 * 显示创建用户模态框
 */
function showCreateUserModal() {
  const content = `
    <form id="create-user-form" onsubmit="handleCreateUser(event)">
      <div class="form-row">
        <div class="form-group">
          <label>姓名 *</label>
          <input type="text" class="form-control" name="name" required placeholder="请输入姓名">
        </div>
        <div class="form-group">
          <label>用户名 *</label>
          <input type="text" class="form-control" name="username" required placeholder="请输入用户名">
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>密码 *</label>
          <input type="password" class="form-control" name="password" required placeholder="请输入密码">
        </div>
        <div class="form-group">
          <label>角色 *</label>
          <select class="form-control" name="role" required>
            <option value="">请选择角色</option>
            <option value="admin">系统管理员</option>
            <option value="teacher">指导教师</option>
            <option value="student">学生</option>
            <option value="enterprise">企业导师</option>
          </select>
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>邮箱</label>
          <input type="email" class="form-control" name="email" placeholder="请输入邮箱">
        </div>
        <div class="form-group">
          <label>电话</label>
          <input type="tel" class="form-control" name="phone" placeholder="请输入电话">
        </div>
      </div>
      
      <div class="form-group">
        <label>部门</label>
        <input type="text" class="form-control" name="department" placeholder="请输入部门">
      </div>
      
      <div class="form-group student-field" style="display:none;">
        <label>学号</label>
        <input type="text" class="form-control" name="studentId" placeholder="请输入学号">
      </div>
      
      <div class="form-group enterprise-field" style="display:none;">
        <label>公司</label>
        <input type="text" class="form-control" name="company" placeholder="请输入公司名称">
      </div>
      
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="submit" class="btn btn-primary">创建用户</button>
      </div>
    </form>
  `;

  showModal('添加用户', content);
  
  // 监听角色变化，显示/隐藏特定字段
  setTimeout(() => {
    const roleSelect = document.querySelector('[name="role"]');
    if (roleSelect) {
      roleSelect.addEventListener('change', function() {
        document.querySelector('.student-field').style.display = this.value === 'student' ? 'block' : 'none';
        document.querySelector('.enterprise-field').style.display = this.value === 'enterprise' ? 'block' : 'none';
      });
    }
  }, 100);
}

/**
 * 处理创建用户
 */
function handleCreateUser(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const userData = Object.fromEntries(formData.entries());
  
  // 检查用户名是否已存在
  const existingUser = dataManager.getUsers().find(u => u.username === userData.username);
  if (existingUser) {
    showToast('用户名已存在', 'error');
    return;
  }
  
  dataManager.createUser(userData);
  closeModal();
  showToast('用户创建成功', 'success');
  navigateTo('users');
}

/**
 * 显示编辑用户模态框
 */
function showEditUserModal(userId) {
  const user = dataManager.getUserById(userId);
  if (!user) {
    showToast('用户不存在', 'error');
    return;
  }

  const content = `
    <form id="edit-user-form" onsubmit="handleEditUser(event, '${userId}')">
      <div class="form-row">
        <div class="form-group">
          <label>姓名 *</label>
          <input type="text" class="form-control" name="name" value="${user.name}" required>
        </div>
        <div class="form-group">
          <label>用户名</label>
          <input type="text" class="form-control" value="${user.username}" disabled>
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>角色 *</label>
          <select class="form-control" name="role" required>
            <option value="admin" ${user.role === 'admin' ? 'selected' : ''}>系统管理员</option>
            <option value="teacher" ${user.role === 'teacher' ? 'selected' : ''}>指导教师</option>
            <option value="student" ${user.role === 'student' ? 'selected' : ''}>学生</option>
            <option value="enterprise" ${user.role === 'enterprise' ? 'selected' : ''}>企业导师</option>
          </select>
        </div>
        <div class="form-group">
          <label>邮箱</label>
          <input type="email" class="form-control" name="email" value="${user.email || ''}">
        </div>
      </div>
      
      <div class="form-row">
        <div class="form-group">
          <label>电话</label>
          <input type="tel" class="form-control" name="phone" value="${user.phone || ''}">
        </div>
        <div class="form-group">
          <label>部门</label>
          <input type="text" class="form-control" name="department" value="${user.department || ''}">
        </div>
      </div>
      
      ${user.role === 'student' ? `
        <div class="form-group">
          <label>学号</label>
          <input type="text" class="form-control" name="studentId" value="${user.studentId || ''}">
        </div>
      ` : ''}
      
      ${user.role === 'enterprise' ? `
        <div class="form-group">
          <label>公司</label>
          <input type="text" class="form-control" name="company" value="${user.company || ''}">
        </div>
      ` : ''}
      
      <div class="form-actions">
        <button type="button" class="btn btn-outline" onclick="closeModal()">取消</button>
        <button type="button" class="btn btn-warning" onclick="resetUserPassword('${userId}')">重置密码</button>
        <button type="submit" class="btn btn-primary">保存修改</button>
      </div>
    </form>
  `;

  showModal('编辑用户', content);
}

/**
 * 处理编辑用户
 */
function handleEditUser(event, userId) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const userData = Object.fromEntries(formData.entries());
  
  dataManager.updateUser(userId, userData);
  closeModal();
  showToast('用户信息已更新', 'success');
  navigateTo('users');
}

/**
 * 重置用户密码
 */
function resetUserPassword(userId) {
  if (confirm('确定要重置该用户的密码吗？')) {
    dataManager.resetUserPassword(userId);
    showToast('密码已重置为默认密码：123456', 'success');
  }
}

/**
 * 确认删除用户
 */
function confirmDeleteUser(userId) {
  const user = dataManager.getUserById(userId);
  if (!user) return;
  
  const content = `
    <div class="text-center">
      <i data-lucide="alert-triangle" style="width:48px;height:48px;margin-bottom:16px;color:var(--amber-500)"></i>
      <h3 class="text-xl font-bold mb-2">确认删除用户</h3>
      <p class="text-muted mb-4">确定要删除用户 <strong>${user.name}</strong> 吗？此操作不可撤销。</p>
    </div>
  `;
  
  showModal('删除确认', content);
  
  // 修改模态框底部按钮
  setTimeout(() => {
    const modalFooter = document.querySelector('.modal-footer');
    if (modalFooter) {
      modalFooter.innerHTML = `
        <button class="btn btn-outline" onclick="closeModal()">取消</button>
        <button class="btn btn-danger" onclick="handleDeleteUser('${userId}')">确认删除</button>
      `;
    }
  }, 50);
}

/**
 * 处理删除用户
 */
function handleDeleteUser(userId) {
  dataManager.deleteUser(userId);
  closeModal();
  showToast('用户已删除', 'success');
  navigateTo('users');
}

// ==================== 移动端菜单 ====================

/**
 * 切换侧边栏折叠
 */
function toggleSidebar() {
  const sidebar = document.getElementById('sidebar');
  sidebar.classList.toggle('collapsed');
  appState.sidebarCollapsed = sidebar.classList.contains('collapsed');
  localStorage.setItem('sidebarCollapsed', appState.sidebarCollapsed);
  
  // 更新图标
  const icon = sidebar.querySelector('.sidebar-toggle-icon');
  if (icon) {
    icon.setAttribute('data-lucide', appState.sidebarCollapsed ? 'panel-left-open' : 'panel-left-close');
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  }
}

/**
 * 切换移动端菜单
 */
function toggleMobileMenu() {
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  sidebar.classList.toggle('mobile-open');
  overlay.classList.toggle('show');
}

/**
 * 关闭移动端菜单
 */
function closeMobileMenu() {
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  sidebar.classList.remove('mobile-open');
  overlay.classList.remove('show');
}

/**
 * 显示用户菜单弹出层
 */
function showUserMenuPopup() {
  const popup = document.getElementById('user-menu-popup');
  popup.classList.toggle('show');
}

/**
 * 关闭用户菜单弹出层
 */
function closeUserMenuPopup() {
  const popup = document.getElementById('user-menu-popup');
  popup.classList.remove('show');
}

/**
 * 添加标签页
 */
function addTab(routeName) {
  const route = ROUTES[routeName];
  if (!route) return;
  
  // 检查标签是否已存在
  const existingTab = appState.tabs.find(tab => tab.key === routeName);
  if (!existingTab) {
    appState.tabs.push({
      key: routeName,
      name: route.name,
      icon: route.icon
    });
  }
  
  appState.activeTab = routeName;
  renderTabs();
}

/**
 * 关闭标签页
 */
function closeTab(routeName, event) {
  if (event) {
    event.stopPropagation();
  }
  
  const index = appState.tabs.findIndex(tab => tab.key === routeName);
  if (index === -1) return;
  
  appState.tabs.splice(index, 1);
  
  // 如果关闭的是当前活动标签，切换到相邻标签
  if (appState.activeTab === routeName) {
    if (appState.tabs.length > 0) {
      const newIndex = Math.min(index, appState.tabs.length - 1);
      appState.activeTab = appState.tabs[newIndex].key;
      navigateTo(appState.activeTab);
    } else {
      appState.activeTab = null;
      navigateTo('dashboard');
    }
  }
  
  renderTabs();
}

/**
 * 渲染标签页
 */
function renderTabs() {
  const tabList = document.getElementById('tab-list');
  if (!tabList) return;
  
  tabList.innerHTML = appState.tabs.map(tab => `
    <div class="tab-item ${tab.key === appState.activeTab ? 'active' : ''}" onclick="navigateTo('${tab.key}')">
      <i data-lucide="${tab.icon}" style="width:12px;height:12px"></i>
      <span>${tab.name}</span>
      <button class="tab-close" onclick="closeTab('${tab.key}', event)">
        <i data-lucide="x" style="width:10px;height:10px"></i>
      </button>
    </div>
  `).join('');
  
  if (typeof lucide !== 'undefined') {
    lucide.createIcons();
  }
}

/**
 * 显示骨架屏
 */
function showSkeleton() {
  const skeleton = document.getElementById('skeleton-screen');
  if (skeleton) {
    skeleton.classList.add('loading');
  }
}

/**
 * 隐藏骨架屏
 */
function hideSkeleton() {
  const skeleton = document.getElementById('skeleton-screen');
  if (skeleton) {
    skeleton.classList.remove('loading');
  }
}

