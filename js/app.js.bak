/**
 * 渲染材料列表
 */
function renderMaterialsList(materials) {
  const container = document.getElementById('materials-list');
  
  if (materials.length === 0) {
    container.innerHTML = '<p class="text-muted">暂无材料，请点击"提交材料"按钮提交。</p>';
    return;
  }
  
  container.innerHTML = `
    <table>
      <thead>
        <tr>
          <th>材料名称</th>
          <th>类型</th>
          <th>关联任务</th>
          <th>状态</th>
          <th>AI评分</th>
          <th>提交时间</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        ${materials.map(material => `
          <tr>
            <td>
              <div class="font-semibold">${material.title}</div>
              <div class="text-muted text-sm">${material.fileName}</div>
            </td>
            <td><span class="badge badge-info">${material.typeName}</span></td>
            <td>${material.taskTitle || '-'}</td>
            <td>${getMaterialStatusBadge(material.status)}</td>
            <td>${material.aiScore !== null ? `<span class="score-badge">${material.aiScore}</span>` : '-'}</td>
            <td>${material.createdAt}</td>
            <td>
              <button class="btn btn-sm btn-outline" onclick="showMaterialDetail(${material.id})">详情</button>
              ${material.status === 'SUBMITTED' || material.status === 'REVISED' ? 
                `<button class="btn btn-sm btn-primary" onclick="triggerAiReview(${material.id})">AI评审</button>` : ''}
            </td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

/**
 * 更新材料统计
 */
function updateMaterialStats(materials) {
  const total = materials.length;
  const approved = materials.filter(m => m.status === 'APPROVED').length;
  const pending = materials.filter(m => m.status === 'SUBMITTED' || m.status === 'AI_REVIEWING').length;
  const scores = materials.filter(m => m.aiScore !== null).map(m => m.aiScore);
  const avgScore = scores.length > 0 ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : '-';
  
  document.getElementById('material-count').textContent = total;
  document.getElementById('material-approved').textContent = approved;
  document.getElementById('material-pending').textContent = pending;
  document.getElementById('material-avg-score').textContent = avgScore;
}

/**
 * 获取材料状态徽章
 */
function getMaterialStatusBadge(status) {
  const statusMap = {
    'SUBMITTED': { class: 'info', text: '已提交' },
    'AI_REVIEWING': { class: 'warning', text: 'AI评审中' },
    'AI_REVIEWED': { class: 'primary', text: 'AI已评审' },
    'MANUAL_REVIEWING': { class: 'warning', text: '人工评审中' },
    'APPROVED': { class: 'success', text: '已通过' },
    'REJECTED': { class: 'danger', text: '已驳回' },
    'REVISED': { class: 'info', text: '已修改' }
  };
  
  const statusInfo = statusMap[status] || { class: 'secondary', text: status };
  return `<span class="badge badge-${statusInfo.class}">${statusInfo.text}</span>`;
}

