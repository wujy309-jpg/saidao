/**
 * 加载材料列表
 */
async function loadMaterials() {
  const currentUser = dataManager.getCurrentUser();
  
  try {
    // 尝试从后端API获取数据
    if (window.API && window.API.getCurrentUserId()) {
      const response = await window.API.MaterialAPI.getUserMaterials(currentUser.id);
      if (response.success) {
        const materials = response.data.map(window.API.DataConverter.convertMaterial);
        renderMaterialsList(materials);
        updateMaterialStats(materials);
        return;
      }
    }
  } catch (error) {
    console.warn('从后端获取材料列表失败，使用本地数据:', error);
  }
  
  // 使用本地模拟数据
  const materials = getLocalMaterials();
  renderMaterialsList(materials);
  updateMaterialStats(materials);
}

