            </div>
            <button type="submit" class="btn btn-primary">保存设置</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <h3><i data-lucide="palette" style="width:18px;height:18px;vertical-align:middle;margin-right:6px"></i>界面设置</h3>
        </div>
        <div class="card-body">
          <div class="form-group">
            <label>主题模式</label>
            <select class="form-control" onchange="handleThemeChange(this.value)">
              <option value="light" ${localStorage.getItem('theme') === 'light' ? 'selected' : ''}>浅色模式</option>
              <option value="dark" ${localStorage.getItem('theme') === 'dark' ? 'selected' : ''}>深色模式</option>
